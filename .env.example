# Lido no build por get.Dotenv: tudo aqui vai para o JS publicado, então só dados públicos.
# Copie para .env (que o .gitignore já exclui) e preencha.

# Identity (auth): base da API, sem barra no fim. Em dev, o proxy do pierrot (settings.json, dev.proxy) leva a /api/v1 do identity; em produção, https://api.murkio.com/v1 (o Caddy troca para /api/v1)
IDENTITY_URL=/api/identity/api/v1
# Chave pública (pk_id_...) da aplicação do Murkio no Identity: a mesma que o Vault aceita (AUTH_APPLICATION_ID).
# A origem do site (http://localhost:3000) precisa estar em origins.allowed_origins dessa aplicação.
IDENTITY_PK=pk_id_troque_aqui

# Vault: base da API, sem barra no fim. Em dev, o proxy do pierrot (settings.json, dev.proxy) leva a /api/v1 do vault; em produção, https://api.murkio.com/v1/vault
VAULT_URL=/api/vault/api/v1
