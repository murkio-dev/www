<script>
    // Página /lambda: por enquanto só o layout (header e footer); o conteúdo ainda não existe.
    // Quando ela ganhar conteúdo, os testes dele entram aqui (Component* e Visual*), como em
    // src/pages/home/index_test.pierrot.
    import en from "../../i18n/en-us.json";
    import pt from "../../i18n/pt-br.json";

    function ComponentPageIsReachable(target) {
        expect().toBeOnUrl(/\/en-us\/lambda\/?$/);
        expect().toHaveCount(0).onClass("error-title");
        expect().toHaveCount(0).onClass("error");
    }

    function ComponentPageKeepsTheSiteLayout(target) {
        expect().toBeVisible().onClass("header");
        expect().toBeVisible().onClass("navbar");
        expect().toBeVisible().onClass("ft");
        expect().toHaveText(en.brand).onClass("logo-name");
    }

    function ComponentPageKeepsTheSiteTitle(target) {
        // a página ainda não define set.Title: vale o título do layout
        expect().toHaveTitle("Murkio");
    }

    function ComponentPageInPortuguese(target) {
        target.Goto("/pt-br/lambda");
        expect().toBeOnUrl(/\/pt-br\/lambda\/?$/);
        expect().toHaveText(pt.header.lang.current).onClass("lm-current");
        expect().toHaveText(pt.header.login).onClass("login");
        expect().toHaveCount(0).onClass("error-title");
    }

    function ComponentServicesMenuLeadsHere(target) {
        target.Goto("/");
        hover().OnClass("services-trigger");
        click().OnSelector(".services-col:last-child .service-item:nth-of-type(2)");
        expect().toBeOnUrl(/\/lambda\/?$/);
        expect().toHaveCount(0).onClass("error-title");
    }

    function VisualPageUsesTheDarkTheme(target) {
        expect().toHaveCSS("background-color", "rgb(0, 0, 0)").onTag("body");
        expect().toHaveCSS("color", "rgb(255, 255, 255)").onTag("body");
    }

    function VisualPageFollowsTheLightTheme(target) {
        click().OnClass("tt");
        expect().toHaveCSS("background-color", "rgb(255, 255, 255)").onTag("body");
    }
</script>
