        <div class="idn-mcp-card idn-panel">
            <h3 class="idn-mcp-title">${i18n.idn.mcp.connectTitle}</h3>
            <p class="idn-mcp-text">${i18n.idn.mcp.connectText}</p>
            <div class="idn-code" aria-hidden="true">
                <div class="idn-code-bar">
                    <StarMark size="16" />
                    <span class="idn-code-file">${i18n.idn.mcp.file}</span>
                </div>
                <div class="idn-code-body">
                    <div class="idn-line"><span class="idn-p">{</span></div>
                    <div class="idn-line"><span class="idn-p">  </span><span class="idn-str">"mcpServers"</span><span class="idn-p">: {</span></div>
                    <div class="idn-line"><span class="idn-p">    </span><span class="idn-str">"murkio-identity"</span><span class="idn-p">: {</span></div>
                    <div class="idn-line"><span class="idn-p">      </span><span class="idn-id">"url"</span><span class="idn-p">: </span><span class="idn-str">"https://mcp.murkio.com/identity"</span></div>
                    <div class="idn-line"><span class="idn-p">    }</span></div>
                    <div class="idn-line"><span class="idn-p">  }</span></div>
                    <div class="idn-line"><span class="idn-p">}</span></div>
                </div>
            </div>
        </div>
    </div>
</section>

