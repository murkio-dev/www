        <h1 class="idn-hero-title">${i18n.idn.hero.title}</h1>
        <p class="idn-hero-subtitle">${i18n.idn.hero.subtitle}</p>
        <div class="idn-hero-actions">
            <Button href="#account" label={i18n.idn.hero.primary} variant="primary" />
