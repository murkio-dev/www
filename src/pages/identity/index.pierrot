</section>

<section class="idn-section" id="how">
    <SectionHead badge={i18n.idn.how.badge} title={i18n.idn.how.title} subtitle={i18n.idn.how.subtitle} />
    <div class="idn-how">
        <div class="idn-code" aria-hidden="true">
            <div class="idn-code-bar">
                <StarMark size="16" />
                <span class="idn-code-file">${i18n.idn.how.file}</span>
                <span class="idn-code-note">${i18n.idn.how.preview}</span>
            </div>
            <div class="idn-code-body">
                <div class="idn-line"><span class="idn-kw">import</span><span class="idn-p"> { </span><span class="idn-id">Identity</span><span class="idn-p"> } </span><span class="idn-kw">from</span><span class="idn-p"> </span><span class="idn-str">"@murkio/identity"</span><span class="idn-p">;</span></div>
                <div class="idn-line idn-blank"></div>
                <div class="idn-line"><span class="idn-kw">const</span><span class="idn-p"> identity = </span><span class="idn-kw">new</span><span class="idn-p"> </span><span class="idn-id">Identity</span><span class="idn-p">({ publicKey: </span><span class="idn-str">"pk_…"</span><span class="idn-p"> });</span></div>
                <div class="idn-line idn-blank"></div>
                <div class="idn-line"><span class="idn-kw">const</span><span class="idn-p"> session = </span><span class="idn-kw">await</span><span class="idn-p"> identity.</span><span class="idn-fn">login</span><span class="idn-p">({ email, password });</span></div>
                <div class="idn-line idn-blank"></div>
                <div class="idn-line"><span class="idn-kw">const</span><span class="idn-p"> me = </span><span class="idn-kw">await</span><span class="idn-p"> identity.</span><span class="idn-fn">me</span><span class="idn-p">();</span></div>
            </div>
        </div>

        <ol class="idn-steps">
            <li class="idn-step idn-panel"><span class="idn-ico"><img src="/assets/icons/ui/plus.svg" alt="" width="20" height="20"></span><div class="idn-step-text"><h3 class="idn-step-title">${i18n.idn.how.s1Title}</h3><p class="idn-step-body">${i18n.idn.how.s1Text}</p></div></li>
            <li class="idn-step idn-panel"><span class="idn-ico"><img src="/assets/icons/ui/code.svg" alt="" width="20" height="20"></span><div class="idn-step-text"><h3 class="idn-step-title">${i18n.idn.how.s2Title}</h3><p class="idn-step-body">${i18n.idn.how.s2Text}</p></div></li>
            <li class="idn-step idn-panel"><span class="idn-ico"><img src="/assets/icons/services/auth.svg" alt="" width="20" height="20"></span><div class="idn-step-text"><h3 class="idn-step-title">${i18n.idn.how.s3Title}</h3><p class="idn-step-body">${i18n.idn.how.s3Text}</p></div></li>
            <li class="idn-step idn-panel"><span class="idn-ico"><img src="/assets/icons/ui/search.svg" alt="" width="20" height="20"></span><div class="idn-step-text"><h3 class="idn-step-title">${i18n.idn.how.s4Title}</h3><p class="idn-step-body">${i18n.idn.how.s4Text}</p></div></li>
        </ol>
    </div>
</section>

<section class="idn-section" id="mcp">
