<script>
    import "./styles.css";
    import { HeroGlow } from "../../components/heroGlow.pierrot";
    import { HeroLights } from "../../components/heroLights.pierrot";
    import { StarMark } from "../../components/starMark.pierrot";
    import { SectionHead } from "../../components/sectionHead.pierrot";
    import { Button } from "../../components/button.pierrot";
    import { IdnCap } from "../../components/idnCap.pierrot";
    import { IdnSdk } from "../../components/idnSdk.pierrot";
    import { IdnFaq } from "../../components/idnFaq.pierrot";
    import { PlanCards } from "../../components/planCards.pierrot";

    set.Title("Murkio Identity");

    // GET https://api.murkio.com/v1/payments/plans?location=brazil&display=true
    // content-type: "application/json"
    // "X-application-id": "01a19d33-557d-77c0-a3a5-297106771a2c"
    const priceMock = [{
        "id": "01a19d31-6309-72ff-871d-8c1a6bbebc27",
        "name": "free",
        "description": "Para validar a sua ideia sem gastar nada.\n\n- E-mail e senha com verificação\n- Login social\n- 2FA por aplicação", // markdown, vem do arquivo .md
        "discount": 0,
        "price": 0,
        "tags": ["free", "1000 users"]
    },
    {
        "id": "01a19d31-6309-72ff-871d-8c1a6bbebc27",
        "name": "pro",
        "description": "Para produtos em crescimento.\n\n- Tudo do **Free**\n- Histórico e auditoria\n- Suporte por e-mail", // markdown, vem do arquivo .md
        "discount": 0,
        "price": 2999,     // moeda Brasileira, logo as 2 ultimas casas são os centavos
        "tags": ["pro", "10000 users"]
    },
    {
        "id": "01a19d31-6309-72ff-871d-8c1a6bbebc27",
        "name": "max",
        "description": "Para quem não pode parar.\n\n- Tudo do **Pro**\n- Tela de login personalizada\n- Suporte `prioritário`", // markdown, vem do arquivo .md
        "discount": 0,
        "price": 4999,     // moeda Brasileira, logo as 2 ultimas casas são os centavos
        "tags": ["max", "1000 users"]
    },
    {
        "id": "01a19d31-6309-72ff-871d-8c1a6bbebc27",
        "name": "pro",
        "description": "Para produtos em crescimento.\n\nTudo do **Free**\nHistórico e auditoria\nSuporte por e-mail", 
        "discount": 0,
        "price": 35988,     // R$ 359,88 (29,99 x 12 meses)
        "tags": ["pro", "10000 users"]
    },
    {
        "id": "01a19d31-6309-72ff-871d-8c1a6bbebc27",
        "name": "max",
        "description": "Para quem não pode parar.\n\nTudo do **Pro**\nTela de login personalizada\nSuporte `prioritário`", 
        "discount": 0,
        "price": 59988,     // R$ 599,88 (49,99 x 12 meses)
        "tags": ["max", "1000 users"]
    }];
</script>

