        <div class="idn-sec idn-panel"><span class="idn-ico"><img src="/assets/icons/ui/rotate.svg" alt="" width="20" height="20"></span><h3 class="idn-sec-title">${i18n.idn.sec.i6Title}</h3><p class="idn-sec-text">${i18n.idn.sec.i6Text}</p></div>
