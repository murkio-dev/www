        <IdnSdk logo="/assets/sdk/svelte.svg" name={i18n.sdk.l4} command="npm install @murkio/identity-svelte" soon={i18n.header.services.soon} />
        <IdnSdk logo="/assets/sdk/kotlin.svg" name={i18n.sdk.l5} command="dev.murkio:identity-kotlin" soon={i18n.header.services.soon} />
        <IdnSdk logo="/assets/sdk/swift.svg" name={i18n.sdk.l6} command="murkio-dev/identity-swift" soon={i18n.header.services.soon} />
        <IdnSdk logo="/assets/sdk/elixir.svg" name={i18n.sdk.l7} command="{:murkio_identity, &quot;~> 0.1&quot;}" soon={i18n.header.services.soon} />
        <IdnSdk logo="/assets/sdk/ruby.svg" name={i18n.sdk.l8} command="gem install murkio-identity" soon={i18n.header.services.soon} />
        <IdnSdk logo="/assets/sdk/php.svg" name={i18n.sdk.l9} command="composer require murkio/identity" soon={i18n.header.services.soon} />
        <IdnSdk logo="/assets/sdk/csharp.svg" name={i18n.sdk.l10} command="dotnet add package Murkio.Identity" soon={i18n.header.services.soon} />
