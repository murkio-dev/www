        <IdnCap icon="/assets/icons/services/vault.svg" title={i18n.idn.caps.c5.title} text={i18n.idn.caps.c5.text} t1={i18n.idn.caps.c5.t1} t2={i18n.idn.caps.c5.t2} t3={i18n.idn.caps.c5.t3} />
        <IdnCap icon="/assets/icons/ui/layers.svg" title={i18n.idn.caps.c6.title} text={i18n.idn.caps.c6.text} t1={i18n.idn.caps.c6.t1} t2={i18n.idn.caps.c6.t2} t3={i18n.idn.caps.c6.t3} />
        <IdnCap icon="/assets/icons/ui/inbox.svg" title={i18n.idn.caps.c7.title} text={i18n.idn.caps.c7.text} t1={i18n.idn.caps.c7.t1} t2={i18n.idn.caps.c7.t2} t3={i18n.idn.caps.c7.t3} />
        <IdnCap icon="/assets/icons/ui/search.svg" title={i18n.idn.caps.c8.title} text={i18n.idn.caps.c8.text} t1={i18n.idn.caps.c8.t1} t2={i18n.idn.caps.c8.t2} t3={i18n.idn.caps.c8.t3} />
        <IdnCap icon="/assets/icons/ui/trash.svg" title={i18n.idn.caps.c9.title} text={i18n.idn.caps.c9.text} t1={i18n.idn.caps.c9.t1} t2={i18n.idn.caps.c9.t2} t3={i18n.idn.caps.c9.t3} />
    </div>
</section>

<section class="idn-section" id="social">
    <SectionHead badge={i18n.idn.providers.badge} title={i18n.idn.providers.title} subtitle={i18n.idn.providers.subtitle} />
    <ul class="idn-providers-list">
        <li class="idn-provider idn-panel"><span class="idn-ico"><img src="/assets/icons/brands/google.svg" alt="" width="20" height="20"></span><span class="idn-provider-name">${i18n.idn.providers.p1}</span></li>
        <li class="idn-provider idn-panel"><span class="idn-ico"><img src="/assets/icons/brands/github.svg" alt="" width="20" height="20"></span><span class="idn-provider-name">${i18n.idn.providers.p2}</span></li>
        <li class="idn-provider idn-panel"><span class="idn-ico"><img src="/assets/icons/brands/apple.svg" alt="" width="20" height="20"></span><span class="idn-provider-name">${i18n.idn.providers.p3}</span></li>
