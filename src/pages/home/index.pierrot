<script>
    import "./styles.css";
    import { HeroGlow } from "../../components/heroGlow.pierrot";
    import { HeroLights } from "../../components/heroLights.pierrot";
    import { HeroGrid } from "../../components/heroGrid.pierrot";
    import { Badge } from "../../components/badge.pierrot";
    import { Button } from "../../components/button.pierrot";
    import { SectionHead } from "../../components/sectionHead.pierrot";
    import { InfraCard } from "../../components/infraCard.pierrot";
    import { StarMark } from "../../components/starMark.pierrot";
    import { VaultFeature } from "../../components/vaultFeature.pierrot";
    import { ComingSoonTag } from "../../components/comingSoonTag.pierrot";
    import { RouterGateway } from "../../components/routerGateway.pierrot";
</script>

<div class="hero-wrap">
<HeroGlow />
<main class="hero">
    <HeroLights />
    <HeroGrid position="top" />
    <HeroGrid position="bottom" />

    <div class="hero-content">
        <Badge label={i18n.home.badge} />

        <h1 class="hero-title">${i18n.home.title}</h1>
        <p class="hero-subtitle">${i18n.home.subtitle}</p>

        <div class="hero-actions">
            <Button href="#services" label={i18n.home.viewServices} variant="secondary" />
            <Button href="#pricing" label={i18n.home.explorePlans} variant="primary" />
        </div>
    </div>
</main>
</div>

<section class="infra" id="services">
    <SectionHead badge={i18n.infra.badge} title={i18n.infra.title} subtitle={i18n.infra.subtitle} />

    <div class="infra-diagram">
