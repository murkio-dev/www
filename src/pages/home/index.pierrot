            <span class="hub-dot hub-dot-1"></span>
            <span class="hub-dot hub-dot-2"></span>
            <span class="hub-dot hub-dot-3"></span>
            <span class="hub-dot hub-dot-4"></span>
            <span class="hub-dot hub-dot-5"></span>
            <span class="hub-dot hub-dot-6"></span>

            <span class="infra-hub-icon"><img src="/assets/icons/ui/code.svg" alt="" width="22" height="22"></span>
            <span class="infra-hub-title">${i18n.infra.hubTitle}</span>
            <span class="infra-hub-subtitle">${i18n.infra.hubSubtitle}</span>
        </div>

        <img class="infra-lines" src="/assets/diagrams/connectors.svg" alt="" aria-hidden="true">

        <div class="infra-groups">
            <div class="infra-group">
                <div class="infra-cards">
                    <InfraCard icon="/assets/icons/services/auth.svg" title={i18n.header.services.auth.title} />
                    <InfraCard icon="/assets/icons/services/messaging.svg" title={i18n.header.services.messaging.title} />
                    <InfraCard icon="/assets/icons/services/payments.svg" title={i18n.header.services.payments.title} />
                </div>
                <span class="infra-bracket"></span>
                <span class="infra-label">${i18n.infra.groupServices}</span>
            </div>

            <div class="infra-divider"></div>

            <div class="infra-group">
                <div class="infra-cards">
                    <InfraCard icon="/assets/icons/services/vault.svg" title={i18n.header.services.vault.title} />
                    <InfraCard icon="/assets/icons/services/lambda.svg" title={i18n.header.services.lambda.title} />
                    <InfraCard icon="/assets/icons/services/database.svg" title={i18n.header.services.database.title} />
                </div>
                <span class="infra-bracket"></span>
                <span class="infra-label">${i18n.infra.groupInfra}</span>
            </div>
        </div>
    </div>
</section>

<section class="sdks" id="sdks">
    <SectionHead badge={i18n.sdks.badge} title={i18n.sdks.title} subtitle={i18n.sdks.subtitle} />

    <div class="sdks-main">
        <ul class="sdks-list">
            <li class="sdks-item">
                <span class="sdks-check"></span>
                <div class="sdks-text">
                    <h3 class="sdks-title">${i18n.sdks.b1Title}</h3>
                    <p class="sdks-body">${i18n.sdks.b1Text}</p>
                </div>
            </li>
            <li class="sdks-item">
                <span class="sdks-check"></span>
                <div class="sdks-text">
                    <h3 class="sdks-title">${i18n.sdks.b2Title}</h3>
                    <p class="sdks-body">${i18n.sdks.b2Text}</p>
                </div>
            </li>
            <li class="sdks-item">
                <span class="sdks-check"></span>
                <div class="sdks-text">
                    <h3 class="sdks-title">${i18n.sdks.b3Title}</h3>
                    <p class="sdks-body">${i18n.sdks.b3Text}</p>
                </div>
            </li>
        </ul>

        <div class="sw" aria-hidden="true">
            <div class="sw-tabs">
                <span class="sw-tab sw-tab-on">${i18n.sdk.l11}</span>
                <span class="sw-tab">${i18n.sdk.l12}</span>
                <span class="sw-tab">${i18n.sdk.l2}</span>
                <span class="sw-tab">${i18n.sdk.l1}</span>
                <span class="sw-tab">${i18n.sdk.l5}</span>
                <span class="sw-tab sw-tab-more">+7</span>
            </div>

            <div class="sw-editor">
                <div class="sw-gutter">
                    <span>1</span>
                    <span>2</span>
                    <span>3</span>
                    <span>4</span>
                    <span>5</span>
                    <span>6</span>
                    <span>7</span>
                    <span>8</span>
                </div>
                <div class="sw-code">
                    <div class="sw-line"><span class="sw-kw">import</span><span class="sw-p"> { </span><span class="sw-id">Murkio</span><span class="sw-p"> } </span><span class="sw-kw">from</span><span class="sw-p"> </span><span class="sw-str">"@murkio/sdk"</span><span class="sw-p">;</span></div>
                    <div class="sw-line sw-blank"></div>
                    <div class="sw-line"><span class="sw-kw">const</span><span class="sw-p"> murkio = </span><span class="sw-kw">new</span><span class="sw-p"> </span><span class="sw-id">Murkio</span><span class="sw-p">({ token: process.env.MURKIO_TOKEN });</span></div>
                    <div class="sw-line sw-blank"></div>
                    <div class="sw-line"><span class="sw-kw">await</span><span class="sw-p"> murkio.identity.</span><span class="sw-fn">login</span><span class="sw-p">({ email, password });</span></div>
                    <div class="sw-line"><span class="sw-kw">const</span><span class="sw-p"> url = </span><span class="sw-kw">await</span><span class="sw-p"> murkio.vault.</span><span class="sw-fn">get</span><span class="sw-p">(</span><span class="sw-str">"DATABASE_URL"</span><span class="sw-p">);</span></div>
                    <div class="sw-line"><span class="sw-kw">await</span><span class="sw-p"> murkio.payments.</span><span class="sw-fn">charge</span><span class="sw-p">({ amount: 4900 });</span></div>
                    <div class="sw-line"><span class="sw-kw">await</span><span class="sw-p"> murkio.messaging.</span><span class="sw-fn">send</span><span class="sw-p">({ user, type: </span><span class="sw-str">"welcome"</span><span class="sw-p"> });</span></div>
                </div>
            </div>
        </div>
    </div>

    <div class="sdks-strip">
        <div class="sdk">
            <span class="sdk-label">${i18n.sdk.title}</span>

            <div class="sdk-viewport">
                <ul class="sdk-track">
                    <li class="sdk-item"><img src="/assets/sdk/typescript.svg" alt="" width="22" height="22"><span>${i18n.sdk.l11}</span></li>
                    <li class="sdk-item"><img src="/assets/sdk/javascript.svg" alt="" width="22" height="22"><span>${i18n.sdk.l12}</span></li>
                    <li class="sdk-item"><img src="/assets/sdk/java.svg" alt="" width="22" height="22"><span>${i18n.sdk.l1}</span></li>
                    <li class="sdk-item"><img src="/assets/sdk/go.svg" alt="" width="22" height="22"><span>${i18n.sdk.l2}</span></li>
                    <li class="sdk-item"><img src="/assets/sdk/react.svg" alt="" width="22" height="22"><span>${i18n.sdk.l3}</span></li>
                    <li class="sdk-item"><img src="/assets/sdk/svelte.svg" alt="" width="22" height="22"><span>${i18n.sdk.l4}</span></li>
                    <li class="sdk-item"><img src="/assets/sdk/kotlin.svg" alt="" width="22" height="22"><span>${i18n.sdk.l5}</span></li>
                    <li class="sdk-item"><img src="/assets/sdk/swift.svg" alt="" width="22" height="22"><span>${i18n.sdk.l6}</span></li>
                    <li class="sdk-item"><img src="/assets/sdk/elixir.svg" alt="" width="22" height="22"><span>${i18n.sdk.l7}</span></li>
                    <li class="sdk-item"><img src="/assets/sdk/ruby.svg" alt="" width="22" height="22"><span>${i18n.sdk.l8}</span></li>
                    <li class="sdk-item"><img src="/assets/sdk/php.svg" alt="" width="22" height="22"><span>${i18n.sdk.l9}</span></li>
                    <li class="sdk-item"><img src="/assets/sdk/csharp.svg" alt="" width="22" height="22"><span>${i18n.sdk.l10}</span></li>
                </ul>
                <ul class="sdk-track sdk-track-copy" aria-hidden="true">
                    <li class="sdk-item"><img src="/assets/sdk/typescript.svg" alt="" width="22" height="22"><span>${i18n.sdk.l11}</span></li>
                    <li class="sdk-item"><img src="/assets/sdk/javascript.svg" alt="" width="22" height="22"><span>${i18n.sdk.l12}</span></li>
                    <li class="sdk-item"><img src="/assets/sdk/java.svg" alt="" width="22" height="22"><span>${i18n.sdk.l1}</span></li>
                    <li class="sdk-item"><img src="/assets/sdk/go.svg" alt="" width="22" height="22"><span>${i18n.sdk.l2}</span></li>
                    <li class="sdk-item"><img src="/assets/sdk/react.svg" alt="" width="22" height="22"><span>${i18n.sdk.l3}</span></li>
                    <li class="sdk-item"><img src="/assets/sdk/svelte.svg" alt="" width="22" height="22"><span>${i18n.sdk.l4}</span></li>
                    <li class="sdk-item"><img src="/assets/sdk/kotlin.svg" alt="" width="22" height="22"><span>${i18n.sdk.l5}</span></li>
                    <li class="sdk-item"><img src="/assets/sdk/swift.svg" alt="" width="22" height="22"><span>${i18n.sdk.l6}</span></li>
                    <li class="sdk-item"><img src="/assets/sdk/elixir.svg" alt="" width="22" height="22"><span>${i18n.sdk.l7}</span></li>
                    <li class="sdk-item"><img src="/assets/sdk/ruby.svg" alt="" width="22" height="22"><span>${i18n.sdk.l8}</span></li>
                    <li class="sdk-item"><img src="/assets/sdk/php.svg" alt="" width="22" height="22"><span>${i18n.sdk.l9}</span></li>
                    <li class="sdk-item"><img src="/assets/sdk/csharp.svg" alt="" width="22" height="22"><span>${i18n.sdk.l10}</span></li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="ai" id="ai">
