<script>
    // Página /vault. Component* = estrutura/comportamento, Visual* = estilo calculado.
    //   pierrot test src/pages/vault -t "^Component"
    //   pierrot test src/pages/vault -t "^Visual"
    import en from "../../i18n/en-us.json";
    import pt from "../../i18n/pt-br.json";

    // ---------- Página ----------

    function ComponentPageIsReachable(target) {
        expect().toBeOnUrl(/\/en-us\/vault\/?$/);
        expect().toHaveCount(0).onClass("error-title");
        expect().toHaveCount(0).onClass("error");
    }

    function ComponentPageKeepsTheSiteLayout(target) {
        expect().toBeVisible().onClass("header");
        expect().toBeVisible().onClass("navbar");
        expect().toBeVisible().onClass("ft");
        expect().toHaveText(en.brand).onClass("logo-name");
    }

    function ComponentPageHasItsOwnTitle(target) {
        expect().toHaveTitle("Murkio Vault");
        expect().toHaveCount(1).onTag("h1");
    }

    function ComponentPageInPortuguese(target) {
        target.Goto("/pt-br/vault");
        expect().toBeOnUrl(/\/pt-br\/vault\/?$/);
        expect().toHaveText(pt.header.lang.current).onClass("lm-current");
        expect().toHaveText(pt.vaultPage.hero.title).onClass("vlt-title");
        expect().toHaveCount(0).onClass("error-title");
    }

    function ComponentServicesMenuLeadsHere(target) {
        target.Goto("/");
        hover().OnClass("services-trigger");
        click().OnSelector(".services-col:last-child .service-item:nth-of-type(1)");
        expect().toBeOnUrl(/\/vault\/?$/);
        expect().toHaveCount(0).onClass("error-title");
    }

    // ---------- Hero ----------

    function ComponentHeroTexts(target) {
        expect().toHaveText(en.vaultPage.hero.title).onClass("vlt-title");
        expect().toHaveText(en.vaultPage.hero.subtitle).onClass("vlt-subtitle");
        expect().toContainText(en.vaultPage.hero.badge).onClass("vlt-badge");
    }

    function ComponentHeroButtons(target) {
        expect().toHaveText(en.vaultPage.hero.primary).onSelector(".vlt-actions .button-primary");
        expect().toHaveText(en.vaultPage.hero.secondary).onSelector(".vlt-actions .button-secondary");
        click().OnSelector(".vlt-actions .button-secondary");
        expect().toBeOnUrl(/#how$/);
    }

    function ComponentHeroGlassCard(target) {
        expect().toHaveText(en.vaultPage.hero.cardTitle).onClass("vlt-card-title");
        expect().toHaveText(en.vaultPage.hero.cardText).onClass("vlt-card-text");
        expect().toContainText(en.vaultPage.hero.cardStatus).onClass("vlt-card-status");
    }

    function ComponentHeroSecretTypesStrip(target) {
        expect().toHaveText(en.vaultPage.hero.stripLabel).onClass("vlt-strip-label");
        expect().toHaveCount(5).onClass("vlt-strip-item");
        expect().toHaveText(en.vaultPage.hero.t1).onSelector(".vlt-strip-item:nth-child(1)");
        expect().toHaveText(en.vaultPage.hero.t5).onSelector(".vlt-strip-item:nth-child(5)");
    }

    // ---------- Seções ----------

    function ComponentHasEverySection(target) {
        for (const id of ["features", "how", "faq"]) {
            expect().toExist().onSelector("section#" + id);
        }
    }

    function ComponentFeatureCards(target) {
        expect().toHaveCount(3).onClass("vf");
        expect().toHaveText(en.vault.feat.f1).onSelector(".vf:nth-child(1) .vf-label");
        expect().toHaveText(en.vault.feat.d3).onSelector(".vf:nth-child(3) .vf-description");
    }

    function ComponentHowItWorks(target) {
        expect().toHaveCount(3).onClass("vlt-step");
        expect().toHaveText(en.vaultPage.how.s1Title).onSelector(".vlt-step:nth-child(1) .vlt-step-title");
        expect().toHaveText(en.vaultPage.how.s3Text).onSelector(".vlt-step:nth-child(3) .vlt-step-body");
        expect().toHaveCount(3).onClass("vlt-line-rm");
        expect().toHaveCount(2).onClass("vlt-line-add");
    }

    function ComponentFaq(target) {
        expect().toHaveCount(5).onClass("idn-faq");
        expect().toHaveText(en.vaultPage.faq.q1).onSelector(".idn-faq:nth-child(1) .idn-faq-q span:first-child");
    }

    // ---------- Rodapé: "Pergunte sobre a Murkio" ----------

    function ComponentFooterAskAboutMurkio(target) {
        expect().toHaveText(en.footer.askLabel).onClass("ft-ask-label");
        expect().toHaveAttribute("data-prompt", en.footer.askPrompt).onClass("ft-ask");
        expect().toHaveCount(5).onClass("ft-ask-btn");
        expect().toHaveAttribute("aria-label", en.footer.askChatgpt).onSelector(".ft-ask-btn:nth-of-type(1)");
        expect().toHaveAttribute("aria-label", en.footer.askClaude).onSelector(".ft-ask-btn:nth-of-type(2)");
        expect().toHaveAttribute("aria-label", en.footer.askGrok).onSelector(".ft-ask-btn:nth-of-type(5)");
    }

    function ComponentFooterAskAboutMurkioInPortuguese(target) {
        target.Goto("/pt-br/vault");
        expect().toHaveText(pt.footer.askLabel).onClass("ft-ask-label");
        expect().toHaveAttribute("aria-label", pt.footer.askClaude).onSelector(".ft-ask-btn:nth-of-type(2)");
    }

    // ---------- Visual ----------

    function VisualPageUsesTheDarkTheme(target) {
        expect().toHaveCSS("background-color", "rgb(0, 0, 0)").onTag("body");
        expect().toHaveCSS("color", "rgb(255, 255, 255)").onTag("body");
    }

    function VisualHeroIsSplitInTwoColumns(target) {
        expect().toBeVisible().onClass("vlt-left");
        expect().toBeVisible().onClass("vlt-right");
        expect().toHaveCSS("display", "grid").onClass("vlt-hero");
    }

    function VisualPageFollowsTheLightTheme(target) {
        click().OnClass("tt");
        expect().toHaveCSS("background-color", "rgb(255, 255, 255)").onTag("body");
    }
</script>
