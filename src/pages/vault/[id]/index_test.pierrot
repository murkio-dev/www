<script>
    // Rota dinâmica /vault/:id: as aplicações da pessoa no Vault. Sem sessão, a tela manda para
    // /authentication com o destino em ?next=. O runner não abre sozinho uma rota com parâmetro:
    // cada teste faz Goto.
    //   pierrot test "src/pages/vault/[id]" -t "^Component"
    import en from "../../../i18n/en-us.json";

    function ComponentWithoutSessionRedirectsToAuthentication(target) {
        target.Goto("/vault/42");
        expect().toBeOnUrl(/\/en-us\/authentication\?next=/);
        expect().toHaveText(en.auth.login.title).onClass("au-title");
    }

    function ComponentNextKeepsTheRequestedPanel(target) {
        target.Goto("/pt-br/vault/42");
        expect().toBeOnUrl(/next=%2Fpt-br%2Fvault%2F42/);
    }

    function ComponentShellRendersBeforeTheRedirect(target) {
        // o HTML estático da rota existe (não é o 404), mesmo que o JS redirecione em seguida
        target.Goto("/vault/42");
        expect().toHaveCount(0).onClass("error-title");
    }
</script>
