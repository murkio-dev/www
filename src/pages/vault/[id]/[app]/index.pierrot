<script>
    import "../styles.css";
    import "./styles.css";
    import { Sidebar } from "../../../../components/sidebar.pierrot";
    import { configureIdentity, ensureSession } from "../../../../scripts/logic/identity.ts";
    import { configureVault, getApplication, renameApplication, deleteApplication, myMembership, listMembers, updateMember, removeMember, listInvitations, createInvitation, revokeInvitation, listSecrets, createSecret, updateSecretValue, renameSecret, deleteSecret, revealSecret, listTokens, createToken, revokeToken, Application, Member, Invitation, Secret, Token, Res } from "../../../../scripts/logic/vault.ts";
    import { isAppName, isEmail, isSecretName, isTokenName, fmtDate, fmtDateTime, shortId, expiresFrom, ruleClass } from "../../../../scripts/logic/rules.ts";

    // Rota /vault/:id/:app: uma aplicação do Vault. :id é a pessoa logada e :app a aplicação dela.
    // Abas: segredos (a tabela de um membro), tokens, membros e convites (só admin) e a aplicação em si.
    set.Title("Murkio Vault");

    configureIdentity(get.Dotenv("IDENTITY_URL"), get.Dotenv("IDENTITY_PK"));
    configureVault(get.Dotenv("VAULT_URL"));

    let vaUid = get.Param("id");
    let vaAppId = get.Param("app");

    // "loading" | "ready" | "missing" | "error"
    let vaState = "loading";
    let vaApp: Application | null = null;
    let vaMe: Member | null = null;
    let vaMembers: Member[] = [];
    let vaInvites: Invitation[] = [];
    let vaSecrets: Secret[] = [];
    let vaTokens: Token[] = [];
    // id do membro cuja tabela está na tela ("me" é o próprio); admins trocam
    let vaOwner = "me";
    let vaTab = "secrets";
    let vaBusy: boolean = false;
    // mensagem geral: "" | "forbidden" | "network" | "unknown" | "renamed" | "lastAdmin"
    let vaMsg = "";
    let vaCopied = "";
    // pedido de confirmação pendente: "secret:<id>" | "token:<id>" | "member:<id>" | "invite:<id>"
    let vaConfirm = "";
    // valores revelados, por id de segredo
    let vaRevealed: { id: string, value: string }[] = [];

    // painel lateral: "" | "secret" | "version" | "rename" | "token" | "invite"
    let vaDrawer = "";
    let vaTarget: Secret | null = null;
    // "" | "name" | "conflict" | "referenced" | "value" | "reference" | "email" | "forbidden" | "network" | "unknown"
    let vaFormErr = "";
    let vaFormDetail = "";

    let vaSecName = "";
    let vaSecType = "string";
    let vaSecSource = "static";
    let vaSecValue = "";
    let vaSecRef = "";
    let vaTokName = "";
    let vaTokExpires = "";
    let vaNewToken: Token | null = null;
    let vaInvEmail = "";
    let vaInvRole = "developer";
    let vaNewInvite = "";
    let vaName = "";
    let vaDeleteName = "";

    function vaIsAdmin(): boolean {
        return vaMe != null && vaMe.role == "admin";
    }

    function vaLang(): string {
        return document.documentElement.lang;
    }

    function vaDate(iso: string | null): string {
        return fmtDate(iso, vaLang());
    }

    function vaWhen(iso: string | null): string {
        return fmtDateTime(iso, vaLang());
    }

    function vaToAuth(): void {
        client.Redirect("/authentication?next=" + encodeURIComponent(location.pathname));
    }

    function vaInviteLink(token: string): string {
        return location.origin + "/vault/" + vaUid + "?invite=" + encodeURIComponent(token);
    }

    // Erro de uma chamada já tratada: traduz o fragmento do RFC 9457 para a chave da mensagem.
    function vaGeneral(error: string): string {
        if (error == "forbidden") {
            return "forbidden";
        }
        if (error == "network") {
            return "network";
        }
        return "unknown";
    }

    function vaFailed(r: Res<any>): boolean {
        if (r.ok) {
            return false;
        }
        if (r.error == "session") {
            vaToAuth();
            return true;
        }
        if (r.error == "conflict" && vaTab == "members") {
            vaMsg = "lastAdmin";
            return true;
        }
        vaMsg = vaGeneral(r.error);
        return true;
    }

    function vaRevealedValue(id: string): string {
        const hit = vaRevealed.find((x) => x.id == id);
        return hit ? hit.value : "";
    }

    function vaIsRevealed(id: string): boolean {
        return vaRevealed.some((x) => x.id == id);
    }

    function vaMemberName(userId: string): string {
        return shortId(userId);
    }

    function vaOwnerLabel(): string {
        if (vaOwner == "me") {
            return "";
        }
        const m = vaMembers.find((x) => x.id == vaOwner);
        return m ? shortId(m.user_id) : shortId(vaOwner);
    }

    function vaRefCandidates(list: Secret[], type: string): Secret[] {
        return list.filter((s) => s.source == "static" && s.type == type);
    }

    function vaStatusClass(s: string): string {
        if (s == "active" || s == "accepted") {
            return "va-pill va-pill-ok";
        }
        if (s == "pending") {
            return "va-pill va-pill-wait";
        }
        return "va-pill va-pill-off";
    }

    function vaTokenStatus(t: Token): string {
        if (t.revoked_at) {
            return "revoked";
        }
        if (t.expires_at && new Date(t.expires_at).getTime() < Date.now()) {
            return "expired";
        }
        return "active";
    }

    function vaCopy(id: string, text: string): void {
        try {
            navigator.clipboard.writeText(text);
        } catch (e) {}
        vaCopied = id;
        time.Sleep(1500).msec();
        vaCopied = "";
    }

    function vaGo(url: string): void {
        client.Redirect(url);
    }

    function vaSetTab(t: string): void {
        vaTab = t;
        vaMsg = "";
        vaConfirm = "";
    }

    function vaAsk(key: string): void {
        vaConfirm = key;
    }

    function vaCancelAsk(): void {
        vaConfirm = "";
    }

    // ---------- carregamento ----------

    async function vaLoadSecrets(): Promise<void> {
        const r = await listSecrets(vaAppId, vaOwner);
        if (vaFailed(r)) {
            return;
        }
        vaSecrets = r.data || [];
        vaRevealed = [];
    }

    async function vaLoadTokens(): Promise<void> {
        const r = await listTokens(vaAppId, vaOwner);
        if (vaFailed(r)) {
            return;
        }
        vaTokens = r.data || [];
    }

    async function vaLoadMembers(): Promise<void> {
        const [m, i] = await Promise.all([listMembers(vaAppId), listInvitations(vaAppId)]);
        if (vaFailed(m) || vaFailed(i)) {
            return;
        }
        vaMembers = m.data || [];
        vaInvites = i.data || [];
    }

    async function vaBoot(): Promise<void> {
        const s = await ensureSession();
        if (!s) {
            vaToAuth();
            return;
        }
        if (vaUid != s.user_id) {
            client.Redirect("/vault/" + s.user_id + "/" + vaAppId);
            return;
        }
        vaState = "loading";
        const [a, m] = await Promise.all([getApplication(vaAppId), myMembership(vaAppId)]);
        if (a.error == "session" || m.error == "session") {
            vaToAuth();
            return;
        }
        if (a.error == "not-found" || m.error == "not-found" || a.error == "validation") {
            vaState = "missing";
            return;
        }
        if (!a.ok || !a.data || !m.ok || !m.data) {
            vaState = "error";
            vaMsg = vaGeneral(a.ok ? m.error : a.error);
            return;
        }
        vaApp = a.data;
        vaMe = m.data;
        vaName = a.data.name;
        await Promise.all([vaLoadSecrets(), vaLoadTokens(), vaIsAdmin() ? vaLoadMembers() : Promise.resolve()]);
        vaState = "ready";
    }

    vaBoot();

    async function vaSetOwner(e: Event): Promise<void> {
        vaOwner = (e.target as HTMLSelectElement).value;
        vaMsg = "";
        vaBusy = true;
        await Promise.all([vaLoadSecrets(), vaLoadTokens()]);
        vaBusy = false;
    }

    // ---------- painel lateral ----------

    function vaOpen(kind: string, target: Secret | null): void {
        vaDrawer = kind;
        vaTarget = target;
        vaFormErr = "";
        vaFormDetail = "";
        vaSecName = kind == "rename" && target ? target.name : "";
        vaSecType = "string";
        vaSecSource = "static";
        vaSecValue = "";
        vaSecRef = "";
        vaTokName = "";
        vaTokExpires = "";
        vaNewToken = null;
        vaInvEmail = "";
        vaInvRole = "developer";
        vaNewInvite = "";
        setTimeout(() => {
            const field = document.querySelector(".va-drawer-open .va-focus") as HTMLElement | null;
            if (field) {
                field.focus();
            }
        }, 80);
    }

    function vaClose(): void {
        if (vaBusy) {
            return;
        }
        const focused = document.activeElement as HTMLElement | null;
        if (focused && focused.blur) {
            focused.blur();
        }
        vaDrawer = "";
        vaTarget = null;
        vaNewToken = null;
        vaNewInvite = "";
    }

    if (typeof window !== "undefined") {
        document.addEventListener("keydown", (e: KeyboardEvent) => {
            if (e.key === "Escape" && vaDrawer != "") {
                const scrim = document.querySelector(".va-scrim") as HTMLElement;
                if (scrim) {
                    scrim.click();
                }
            }
        });
    }

    // Erro de um formulário do painel: traduz o fragmento do RFC 9457 e os invalid_params.
    function vaFormFail(r: Res<any>): void {
        vaFormDetail = r.detail;
        if (r.error == "session") {
            vaToAuth();
            return;
        }
        if (r.error == "conflict") {
            vaFormErr = "conflict";
            return;
        }
        if (r.error == "forbidden") {
            vaFormErr = "forbidden";
            return;
        }
        if (r.error == "network") {
            vaFormErr = "network";
            return;
        }
        if (r.error == "validation") {
            const names = r.params.map((p) => p.name);
            if (names.indexOf("name") >= 0) {
                vaFormErr = "name";
            } else if (names.indexOf("value") >= 0) {
                vaFormErr = "value";
            } else if (names.indexOf("reference_secret_id") >= 0 || names.indexOf("source") >= 0) {
                vaFormErr = "reference";
            } else if (names.indexOf("email") >= 0) {
                vaFormErr = "email";
            } else {
                vaFormErr = "unknown";
            }
            return;
        }
        vaFormErr = "unknown";
    }

    function vaSecretReady(): boolean {
        if (!isSecretName(vaSecName)) {
            return false;
        }
        if (vaSecSource == "reference") {
            return vaSecRef != "";
        }
        return vaSecValue != "";
    }

    async function vaSubmitSecret(e: Event): Promise<void> {
        e.preventDefault();
        if (!vaSecretReady() || vaBusy) {
            return;
        }
        vaBusy = true;
        vaFormErr = "";
        const body = vaSecSource == "reference"
            ? { name: vaSecName, type: vaSecType, source: "reference", reference_secret_id: vaSecRef }
            : { name: vaSecName, type: vaSecType, value: vaSecValue };
        const r = await createSecret(vaAppId, vaOwner, body);
        vaBusy = false;
        if (!r.ok) {
            vaFormFail(r);
            return;
        }
        await vaLoadSecrets();
        vaClose();
    }

    async function vaSubmitVersion(e: Event): Promise<void> {
        e.preventDefault();
        if (vaSecValue == "" || vaBusy || !vaTarget) {
            return;
        }
        vaBusy = true;
        vaFormErr = "";
        const r = await updateSecretValue(vaAppId, vaOwner, vaTarget.id, vaSecValue);
        vaBusy = false;
        if (!r.ok) {
            vaFormFail(r);
            return;
        }
        await vaLoadSecrets();
        vaClose();
    }

    async function vaSubmitRename(e: Event): Promise<void> {
        e.preventDefault();
        if (!isSecretName(vaSecName) || vaBusy || !vaTarget) {
            return;
        }
        vaBusy = true;
        vaFormErr = "";
        const r = await renameSecret(vaAppId, vaOwner, vaTarget.id, vaSecName);
        vaBusy = false;
        if (!r.ok) {
            vaFormFail(r);
            return;
        }
        await vaLoadSecrets();
        vaClose();
    }

    async function vaReveal(s: Secret): Promise<void> {
        if (vaIsRevealed(s.id)) {
            vaRevealed = vaRevealed.filter((x) => x.id != s.id);
            return;
        }
        vaMsg = "";
        const r = await revealSecret(vaAppId, vaOwner, s.id);
        if (vaFailed(r) || !r.data) {
            return;
        }
        vaRevealed = [...vaRevealed, { id: s.id, value: r.data.value }];
    }

    async function vaDeleteSecret(id: string): Promise<void> {
        vaConfirm = "";
        vaMsg = "";
        const r = await deleteSecret(vaAppId, vaOwner, id);
        if (!r.ok) {
            if (r.error == "conflict") {
                vaMsg = "referenced";
                return;
            }
            vaFailed(r);
            return;
        }
        await vaLoadSecrets();
    }

    async function vaSubmitToken(e: Event): Promise<void> {
        e.preventDefault();
        if (!isTokenName(vaTokName) || vaBusy) {
            return;
        }
        vaBusy = true;
        vaFormErr = "";
        const r = await createToken(vaAppId, vaOwner, vaTokName.trim(), expiresFrom(vaTokExpires));
        vaBusy = false;
        if (!r.ok || !r.data) {
            vaFormFail(r);
            return;
        }
        vaNewToken = r.data;
        await vaLoadTokens();
    }

    async function vaRevoke(id: string): Promise<void> {
        vaConfirm = "";
        vaMsg = "";
        const r = await revokeToken(vaAppId, vaOwner, id);
        if (vaFailed(r)) {
            return;
        }
        await vaLoadTokens();
    }

    async function vaPatchMember(id: string, patch: { role?: string, status?: string }): Promise<void> {
        vaMsg = "";
        const r = await updateMember(vaAppId, id, patch);
        if (vaFailed(r)) {
            return;
        }
        await vaLoadMembers();
    }

    async function vaRemoveMember(id: string): Promise<void> {
        vaConfirm = "";
        vaMsg = "";
        const r = await removeMember(vaAppId, id);
        if (vaFailed(r)) {
            return;
        }
        if (vaOwner == id) {
            vaOwner = "me";
            await Promise.all([vaLoadSecrets(), vaLoadTokens()]);
        }
        await vaLoadMembers();
    }

    async function vaSubmitInvite(e: Event): Promise<void> {
        e.preventDefault();
        if (!isEmail(vaInvEmail) || vaBusy) {
            return;
        }
        vaBusy = true;
        vaFormErr = "";
        const r = await createInvitation(vaAppId, vaInvEmail.trim().toLowerCase(), vaInvRole);
        vaBusy = false;
        if (!r.ok || !r.data || !r.data.token) {
            vaFormFail(r);
            return;
        }
        vaNewInvite = vaInviteLink(r.data.token);
        await vaLoadMembers();
    }

    async function vaRevokeInvite(id: string): Promise<void> {
        vaConfirm = "";
        vaMsg = "";
        const r = await revokeInvitation(vaAppId, id);
        if (vaFailed(r)) {
            return;
        }
        await vaLoadMembers();
    }

    async function vaSubmitAppName(e: Event): Promise<void> {
        e.preventDefault();
        if (!isAppName(vaName) || vaBusy || !vaApp || vaName == vaApp.name) {
            return;
        }
        vaBusy = true;
        vaMsg = "";
        vaFormErr = "";
        const r = await renameApplication(vaAppId, vaName);
        vaBusy = false;
        if (!r.ok || !r.data) {
            vaFormFail(r);
            return;
        }
        vaApp = r.data;
        vaMsg = "renamed";
    }

    async function vaDeleteApp(e: Event): Promise<void> {
        e.preventDefault();
        if (!vaApp || vaDeleteName != vaApp.name || vaBusy) {
            return;
        }
        vaBusy = true;
        const r = await deleteApplication(vaAppId);
        vaBusy = false;
        if (vaFailed(r)) {
            return;
        }
        client.Redirect("/vault/" + vaUid);
    }
</script>

<div class="vnw">
    <Sidebar service="Vault" active="1" settingsHref={"/vault/" + vaUid}
        label1={i18n.vaultNew.nav.apps} icon1="/assets/icons/ui/layers.svg" href1={"/vault/" + vaUid}
        label2={i18n.vaultNew.nav.sdks} icon2="/assets/icons/ui/code.svg" href2="/vault#how"
        label3={i18n.vaultNew.nav.mcp} icon3="/assets/icons/ui/bolt.svg" href3="/vault#faq" />

    <div class="vnw-right">
    <main class="vnw-main">
        <div class="vnw-bar">
            <nav class="vnw-crumbs" aria-label="breadcrumb">
                <button class="vnw-crumb va-crumb-link" type="button" @click={vaGo("/vault/" + vaUid)}>vault</button>
                <span class="vnw-crumb-sep">/</span>
                @if vaApp
                    <span class="vnw-crumb va-crumb-app">${vaApp.name}</span>
                @end
            </nav>
            @if vaMe
                @if vaIsAdmin()
                    <span class="vnw-role vnw-role-admin">${i18n.vaultApp.roles.admin}</span>
                @else
                    <span class="vnw-role">${i18n.vaultApp.roles.developer}</span>
                @end
            @end
        </div>

        <hr class="vnw-hr">

        @if vaState == "loading"
            <p class="vnw-loading" role="status">${i18n.vaultApp.loading}</p>
        @end

        @if vaState == "missing"
            <div class="vnw-fail" role="alert">
                <span>${i18n.vaultApp.notFound}</span>
                <button class="vnw-btn vnw-btn-ghost vnw-btn-sm" type="button" @click={vaGo("/vault/" + vaUid)}>${i18n.vaultNew.nav.apps}</button>
            </div>
        @end

        @if vaState == "error"
            <div class="vnw-fail" role="alert">
                <span>${i18n.vaultApp.loadError}</span>
                <button class="vnw-btn vnw-btn-ghost vnw-btn-sm" type="button" @click={vaBoot}>${i18n.vaultApp.retry}</button>
            </div>
        @end

        @if vaState == "ready"
            <div class="vnw-tools">
                <div class="vnw-tabs" role="tablist">
                    <button class="${vaTab == 'secrets' ? 'vnw-tab vnw-tab-on' : 'vnw-tab'}" type="button" role="tab" @click={vaSetTab("secrets")}>${i18n.vaultApp.tabs.secrets}<span class="vnw-tab-n">${vaSecrets.length}</span></button>
                    <button class="${vaTab == 'tokens' ? 'vnw-tab vnw-tab-on' : 'vnw-tab'}" type="button" role="tab" @click={vaSetTab("tokens")}>${i18n.vaultApp.tabs.tokens}<span class="vnw-tab-n">${vaTokens.length}</span></button>
                    @if vaIsAdmin()
                        <button class="${vaTab == 'members' ? 'vnw-tab vnw-tab-on' : 'vnw-tab'}" type="button" role="tab" @click={vaSetTab("members")}>${i18n.vaultApp.tabs.members}<span class="vnw-tab-n">${vaMembers.length}</span></button>
                    @end
                    <button class="${vaTab == 'settings' ? 'vnw-tab vnw-tab-on' : 'vnw-tab'}" type="button" role="tab" @click={vaSetTab("settings")}>${i18n.vaultApp.tabs.settings}</button>
                </div>

                @if vaIsAdmin() && (vaTab == "secrets" || vaTab == "tokens")
                    <label class="va-owner">
                        <span class="va-owner-label">${i18n.vaultApp.secrets.owner}</span>
                        <select class="vnw-input va-owner-pick" @change={vaSetOwner(event)}>
                            <option value="me">${i18n.vaultApp.secrets.mine}</option>
                            @for m in vaMembers
                                @if vaMe && m.id != vaMe.id
                                    <option value="${m.id}">${vaMemberName(m.user_id)} · ${m.role}</option>
                                @end
                            @end
                        </select>
                    </label>
                @end
            </div>

            @if vaMsg == "forbidden"
                <p class="vnw-error va-msg" role="alert">${i18n.vaultApp.forbidden}</p>
            @end
            @if vaMsg == "network"
                <p class="vnw-error va-msg" role="alert">${i18n.vaultApp.network}</p>
            @end
            @if vaMsg == "unknown"
                <p class="vnw-error va-msg" role="alert">${i18n.vaultApp.unknown}</p>
            @end
            @if vaMsg == "referenced"
                <p class="vnw-error va-msg" role="alert">${i18n.vaultApp.secrets.errors.referenced}</p>
            @end
            @if vaMsg == "lastAdmin"
                <p class="vnw-error va-msg" role="alert">${i18n.vaultApp.members.lastAdmin}</p>
            @end
            @if vaMsg == "renamed"
                <p class="vnw-ok va-msg" role="status">${i18n.vaultApp.settings.renamed}</p>
            @end

            <!-- ---------- Segredos ---------- -->
            @if vaTab == "secrets"
                <section class="va-section" aria-label="${i18n.vaultApp.secrets.title}">
                    <div class="va-head">
                        <div>
                            <h2 class="va-title">${i18n.vaultApp.secrets.title}</h2>
                            <p class="va-text">${i18n.vaultApp.secrets.text}</p>
                        </div>
                        <button class="vnw-btn vnw-btn-primary vnw-open" type="button" @click={vaOpen("secret", null)}>
                            <img class="vnw-open-icon" src="/assets/icons/ui/plus.svg" alt="" width="14" height="14">${i18n.vaultApp.secrets.create}
                        </button>
                    </div>

                    @if vaSecrets.length == 0
                        <div class="vnw-none">
                            <h3 class="vnw-none-title">${i18n.vaultApp.secrets.empty}</h3>
                            <p class="vnw-none-text">${i18n.vaultApp.secrets.emptyText}</p>
                        </div>
                    @else
                        <div class="va-rows">
                            @for s in vaSecrets
                                <article class="va-row ${vaIsRevealed(s.id) ? 'va-row-open' : ''}">
                                    <div class="va-row-main">
                                        <code class="va-key">${s.name}</code>
                                        <span class="va-type">${s.type}</span>
                                        @if s.source == "reference"
                                            <span class="vnw-role">${i18n.vaultApp.secrets.reference}</span>
                                        @end
                                        <span class="va-meta">v${s.version} · ${vaDate(s.updated_at || s.created_at)}</span>
                                    </div>
                                    <div class="va-row-actions">
                                        @if vaIsRevealed(s.id)
                                            <button class="va-act" type="button" @click={vaReveal(s)}>${i18n.vaultApp.secrets.hide}</button>
                                        @else
                                            <button class="va-act" type="button" @click={vaReveal(s)}>${i18n.vaultApp.secrets.reveal}</button>
                                        @end
                                        @if s.source == "static"
                                            <button class="va-act" type="button" @click={vaOpen("version", s)}>${i18n.vaultApp.secrets.newVersion}</button>
                                        @end
                                        <button class="va-act" type="button" @click={vaOpen("rename", s)}>${i18n.vaultApp.secrets.rename}</button>
                                        @if vaConfirm == "secret:" + s.id
                                            <span class="va-ask">
                                                <span class="va-ask-text">${i18n.vaultApp.secrets.deleteAsk}</span>
                                                <button class="va-act va-act-danger" type="button" @click={vaDeleteSecret(s.id)}>${i18n.vaultApp.confirm}</button>
                                                <button class="va-act" type="button" @click={vaCancelAsk}>${i18n.vaultApp.cancel}</button>
                                            </span>
                                        @else
                                            <button class="va-act va-act-danger" type="button" @click={vaAsk("secret:" + s.id)}>${i18n.vaultApp.secrets.delete}</button>
                                        @end
                                    </div>
                                    @if vaIsRevealed(s.id)
                                        <div class="va-value">
                                            <code class="va-value-text">${vaRevealedValue(s.id)}</code>
                                            <button class="vnw-copy" type="button" @click={vaCopy(s.id, vaRevealedValue(s.id))}>
                                                @if vaCopied == s.id
                                                    <span class="vnw-copy-tag vnw-copy-done">${i18n.vaultApp.copied}</span>
                                                @else
                                                    <span class="vnw-copy-tag">${i18n.vaultApp.copy}</span>
                                                @end
                                            </button>
                                        </div>
                                    @end
                                </article>
                            @end
                        </div>
                    @end
                </section>
            @end

            <!-- ---------- Tokens ---------- -->
            @if vaTab == "tokens"
                <section class="va-section" aria-label="${i18n.vaultApp.tokens.title}">
                    <div class="va-head">
                        <div>
                            <h2 class="va-title">${i18n.vaultApp.tokens.title}</h2>
                            <p class="va-text">${i18n.vaultApp.tokens.text}</p>
                        </div>
                        <button class="vnw-btn vnw-btn-primary vnw-open" type="button" @click={vaOpen("token", null)}>
                            <img class="vnw-open-icon" src="/assets/icons/ui/plus.svg" alt="" width="14" height="14">${i18n.vaultApp.tokens.create}
                        </button>
                    </div>

                    @if vaTokens.length == 0
                        <div class="vnw-none">
                            <h3 class="vnw-none-title">${i18n.vaultApp.tokens.empty}</h3>
                            <p class="vnw-none-text">${i18n.vaultApp.tokens.emptyText}</p>
                        </div>
                    @else
                        <table class="vnw-table va-table">
                            <thead>
                                <tr>
                                    <th class="vnw-th">${i18n.vaultApp.tokens.name}</th>
                                    <th class="vnw-th">${i18n.vaultApp.tokens.prefix}</th>
                                    <th class="vnw-th">${i18n.vaultApp.tokens.lastUsed}</th>
                                    <th class="vnw-th">${i18n.vaultApp.tokens.expires}</th>
                                    <th class="vnw-th">${i18n.vaultApp.tokens.status}</th>
                                    <th class="vnw-th va-col-act"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for t in vaTokens
                                    <tr class="vnw-tr">
                                        <td class="vnw-td">${t.name}</td>
                                        <td class="vnw-td"><code class="va-mono">${t.prefix}…</code></td>
                                        <td class="vnw-td">
                                            @if t.last_used_at
                                                ${vaWhen(t.last_used_at)}
                                            @else
                                                ${i18n.vaultApp.never}
                                            @end
                                        </td>
                                        <td class="vnw-td">
                                            @if t.expires_at
                                                ${vaDate(t.expires_at)}
                                            @else
                                                ${i18n.vaultApp.never}
                                            @end
                                        </td>
                                        <td class="vnw-td">
                                            @if vaTokenStatus(t) == "active"
                                                <span class="va-pill va-pill-ok">${i18n.vaultApp.status.active}</span>
                                            @end
                                            @if vaTokenStatus(t) == "revoked"
                                                <span class="va-pill va-pill-off">${i18n.vaultApp.status.revoked}</span>
                                            @end
                                            @if vaTokenStatus(t) == "expired"
                                                <span class="va-pill va-pill-off">${i18n.vaultApp.status.expired}</span>
                                            @end
                                        </td>
                                        <td class="vnw-td va-col-act">
                                            @if vaTokenStatus(t) == "active"
                                                @if vaConfirm == "token:" + t.id
                                                    <span class="va-ask">
                                                        <button class="va-act va-act-danger" type="button" @click={vaRevoke(t.id)}>${i18n.vaultApp.confirm}</button>
                                                        <button class="va-act" type="button" @click={vaCancelAsk}>${i18n.vaultApp.cancel}</button>
                                                    </span>
                                                @else
                                                    <button class="va-act va-act-danger" type="button" @click={vaAsk("token:" + t.id)}>${i18n.vaultApp.tokens.revoke}</button>
                                                @end
                                            @end
                                        </td>
                                    </tr>
                                @end
                            </tbody>
                        </table>
                    @end
                </section>
            @end

            <!-- ---------- Membros e convites ---------- -->
            @if vaTab == "members"
                <section class="va-section" aria-label="${i18n.vaultApp.members.title}">
                    <div class="va-head">
                        <div>
                            <h2 class="va-title">${i18n.vaultApp.members.title}</h2>
                            <p class="va-text">${i18n.vaultApp.members.text}</p>
                        </div>
                        <button class="vnw-btn vnw-btn-primary vnw-open" type="button" @click={vaOpen("invite", null)}>
                            <img class="vnw-open-icon" src="/assets/icons/ui/plus.svg" alt="" width="14" height="14">${i18n.vaultApp.members.invite}
                        </button>
                    </div>

                    <table class="vnw-table va-table">
                        <thead>
                            <tr>
                                <th class="vnw-th">${i18n.vaultApp.members.user}</th>
                                <th class="vnw-th">${i18n.vaultApp.members.role}</th>
                                <th class="vnw-th">${i18n.vaultApp.members.status}</th>
                                <th class="vnw-th">${i18n.vaultApp.members.since}</th>
                                <th class="vnw-th va-col-act"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for m in vaMembers
                                <tr class="vnw-tr">
                                    <td class="vnw-td">
                                        <code class="va-mono">${vaMemberName(m.user_id)}</code>
                                        @if m.user_id == vaUid
                                            <span class="vnw-tag">${i18n.vaultApp.you}</span>
                                        @end
                                    </td>
                                    <td class="vnw-td">
                                        @if m.role == "admin"
                                            <span class="vnw-role vnw-role-admin">${i18n.vaultApp.roles.admin}</span>
                                        @else
                                            <span class="vnw-role">${i18n.vaultApp.roles.developer}</span>
                                        @end
                                    </td>
                                    <td class="vnw-td">
                                        @if m.status == "active"
                                            <span class="va-pill va-pill-ok">${i18n.vaultApp.status.active}</span>
                                        @else
                                            <span class="va-pill va-pill-off">${i18n.vaultApp.status.suspended}</span>
                                        @end
                                    </td>
                                    <td class="vnw-td">${vaDate(m.created_at)}</td>
                                    <td class="vnw-td va-col-act">
                                        @if vaConfirm == "member:" + m.id
                                            <span class="va-ask">
                                                <span class="va-ask-text">${i18n.vaultApp.members.removeAsk}</span>
                                                <button class="va-act va-act-danger" type="button" @click={vaRemoveMember(m.id)}>${i18n.vaultApp.confirm}</button>
                                                <button class="va-act" type="button" @click={vaCancelAsk}>${i18n.vaultApp.cancel}</button>
                                            </span>
                                        @else
                                            @if m.role == "admin"
                                                <button class="va-act" type="button" @click={vaPatchMember(m.id, { role: "developer" })}>${i18n.vaultApp.members.makeDev}</button>
                                            @else
                                                <button class="va-act" type="button" @click={vaPatchMember(m.id, { role: "admin" })}>${i18n.vaultApp.members.makeAdmin}</button>
                                            @end
                                            @if m.status == "active"
                                                <button class="va-act" type="button" @click={vaPatchMember(m.id, { status: "suspended" })}>${i18n.vaultApp.members.suspend}</button>
                                            @else
                                                <button class="va-act" type="button" @click={vaPatchMember(m.id, { status: "active" })}>${i18n.vaultApp.members.activate}</button>
                                            @end
                                            <button class="va-act va-act-danger" type="button" @click={vaAsk("member:" + m.id)}>${i18n.vaultApp.members.remove}</button>
                                        @end
                                    </td>
                                </tr>
                            @end
                        </tbody>
                    </table>

                    <h3 class="vnw-section va-sub">${i18n.vaultApp.members.invites}</h3>
                    <p class="vnw-hint vnw-hint-flush">${i18n.vaultApp.members.invitesText}</p>

                    @if vaInvites.length == 0
                        <p class="vnw-empty">${i18n.vaultApp.members.noInvites}</p>
                    @else
                        <table class="vnw-table va-table">
                            <thead>
                                <tr>
                                    <th class="vnw-th">${i18n.vaultApp.members.emailLabel}</th>
                                    <th class="vnw-th">${i18n.vaultApp.members.role}</th>
                                    <th class="vnw-th">${i18n.vaultApp.members.status}</th>
                                    <th class="vnw-th">${i18n.vaultApp.members.expires}</th>
                                    <th class="vnw-th va-col-act"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @for inv in vaInvites
                                    <tr class="vnw-tr">
                                        <td class="vnw-td vnw-td-email">${inv.email}</td>
                                        <td class="vnw-td">
                                            @if inv.role == "admin"
                                                <span class="vnw-role vnw-role-admin">${i18n.vaultApp.roles.admin}</span>
                                            @else
                                                <span class="vnw-role">${i18n.vaultApp.roles.developer}</span>
                                            @end
                                        </td>
                                        <td class="vnw-td">
                                            @if inv.status == "pending"
                                                <span class="${vaStatusClass(inv.status)}">${i18n.vaultApp.status.pending}</span>
                                            @end
                                            @if inv.status == "accepted"
                                                <span class="${vaStatusClass(inv.status)}">${i18n.vaultApp.status.accepted}</span>
                                            @end
                                            @if inv.status == "revoked"
                                                <span class="${vaStatusClass(inv.status)}">${i18n.vaultApp.status.revoked}</span>
                                            @end
                                            @if inv.status == "expired"
                                                <span class="${vaStatusClass(inv.status)}">${i18n.vaultApp.status.expired}</span>
                                            @end
                                        </td>
                                        <td class="vnw-td">${vaDate(inv.expires_at)}</td>
                                        <td class="vnw-td va-col-act">
                                            @if inv.status == "pending"
                                                @if vaConfirm == "invite:" + inv.id
                                                    <span class="va-ask">
                                                        <button class="va-act va-act-danger" type="button" @click={vaRevokeInvite(inv.id)}>${i18n.vaultApp.confirm}</button>
                                                        <button class="va-act" type="button" @click={vaCancelAsk}>${i18n.vaultApp.cancel}</button>
                                                    </span>
                                                @else
                                                    <button class="va-act va-act-danger" type="button" @click={vaAsk("invite:" + inv.id)}>${i18n.vaultApp.members.revoke}</button>
                                                @end
                                            @end
                                        </td>
                                    </tr>
                                @end
                            </tbody>
                        </table>
                    @end
                </section>
            @end

            <!-- ---------- Aplicação ---------- -->
            @if vaTab == "settings"
                <section class="va-section va-settings" aria-label="${i18n.vaultApp.settings.title}">
                    <form class="va-card" @submit={vaSubmitAppName(event)}>
                        <label class="vnw-label" for="va-app-name">${i18n.vaultApp.settings.nameLabel}</label>
                        @if vaIsAdmin()
                            <input id="va-app-name" class="vnw-input" type="text" autocomplete="off" spellcheck="false" maxlength="60" @bind={vaName}>
                        @else
                            <input id="va-app-name" class="vnw-input" type="text" disabled @bind={vaName}>
                        @end
                        <p class="vnw-hint">${i18n.vaultApp.settings.nameHint}</p>
                        @if !vaIsAdmin()
                            <p class="vnw-hint">${i18n.vaultApp.onlyAdmin}</p>
                        @end
                        @if vaFormErr == "conflict" && vaDrawer == ""
                            <p class="vnw-error">${i18n.vaultApp.settings.errors.conflict}</p>
                        @end
                        @if vaFormErr == "name" && vaDrawer == ""
                            <p class="vnw-error">${i18n.vaultApp.settings.errors.name}</p>
                        @end
                        @if vaIsAdmin()
                            <div class="va-card-actions">
                                @if vaBusy
                                    <button class="vnw-btn vnw-btn-primary" type="submit" disabled>${i18n.vaultApp.saving}</button>
                                @else
                                    @if vaApp && isAppName(vaName) && vaName != vaApp.name
                                        <button class="vnw-btn vnw-btn-primary" type="submit">${i18n.vaultApp.settings.rename}</button>
                                    @else
                                        <button class="vnw-btn vnw-btn-primary" type="submit" disabled>${i18n.vaultApp.settings.rename}</button>
                                    @end
                                @end
                            </div>
                        @end
                    </form>

                    @if vaIsAdmin()
                        <form class="va-card va-card-danger" @submit={vaDeleteApp(event)}>
                            <h3 class="va-title">${i18n.vaultApp.settings.danger}</h3>
                            <p class="va-text">${i18n.vaultApp.settings.dangerText}</p>
                            <label class="vnw-label" for="va-del-name">${i18n.vaultApp.settings.confirmLabel}</label>
                            @if vaApp
                                <input id="va-del-name" class="vnw-input" type="text" autocomplete="off" spellcheck="false" placeholder="${vaApp.name}" @bind={vaDeleteName}>
                            @end
                            <div class="va-card-actions">
                                @if vaApp && vaDeleteName == vaApp.name && !vaBusy
                                    <button class="vnw-btn va-btn-danger" type="submit">${i18n.vaultApp.settings.delete}</button>
                                @else
                                    <button class="vnw-btn va-btn-danger" type="submit" disabled>${i18n.vaultApp.settings.delete}</button>
                                @end
                            </div>
                        </form>
                    @end
                </section>
            @end
        @end
    </main>
    </div>

    <div class="vnw-scrim va-scrim ${vaDrawer != '' ? 'vnw-scrim-on' : ''}" @click={vaClose}></div>

    <aside class="vnw-drawer ${vaDrawer != '' ? 'vnw-drawer-open va-drawer-open' : ''}">
        <div class="vnw-drawer-head">
            @if vaDrawer == "secret"
                <h2 class="vnw-drawer-title">${i18n.vaultApp.secrets.create}</h2>
            @end
            @if vaDrawer == "version"
                <h2 class="vnw-drawer-title">${i18n.vaultApp.secrets.newVersion}</h2>
            @end
            @if vaDrawer == "rename"
                <h2 class="vnw-drawer-title">${i18n.vaultApp.secrets.rename}</h2>
            @end
            @if vaDrawer == "token"
                <h2 class="vnw-drawer-title">${i18n.vaultApp.tokens.create}</h2>
            @end
            @if vaDrawer == "invite"
                <h2 class="vnw-drawer-title">${i18n.vaultApp.members.invite}</h2>
            @end
            <button class="vnw-close" type="button" aria-label="${i18n.vaultApp.close}" @click={vaClose}>
                <img src="/assets/icons/ui/plus.svg" alt="" width="14" height="14" class="vnw-close-icon">
            </button>
        </div>

        @if vaDrawer == "secret"
            <form class="vnw-form" @submit={vaSubmitSecret(event)}>
                <div class="vnw-scroll">
                    @if vaOwnerLabel() != ""
                        <p class="vnw-subtitle">${i18n.vaultApp.secrets.owner} <code class="va-mono">${vaOwnerLabel()}</code></p>
                    @end
                    <label class="vnw-label" for="va-sec-name">${i18n.vaultApp.secrets.nameLabel}</label>
                    <input id="va-sec-name" class="vnw-input va-focus" type="text" autocomplete="off" spellcheck="false" maxlength="128" placeholder="${i18n.vaultApp.secrets.namePlaceholder}" @bind={vaSecName}>
                    <p class="vnw-hint ${ruleClass(vaSecName, isSecretName(vaSecName), 'va-hint')}">${i18n.vaultApp.secrets.nameHint}</p>

                    <label class="vnw-label" for="va-sec-type">${i18n.vaultApp.secrets.typeLabel}</label>
                    <select id="va-sec-type" class="vnw-input va-select" @bind={vaSecType}>
                        <option value="string">${i18n.vaultApp.secrets.types.string}</option>
                        <option value="password">${i18n.vaultApp.secrets.types.password}</option>
                        <option value="url">${i18n.vaultApp.secrets.types.url}</option>
                        <option value="database_uri">${i18n.vaultApp.secrets.types.database_uri}</option>
                        <option value="api_key">${i18n.vaultApp.secrets.types.api_key}</option>
                        <option value="jwt_key">${i18n.vaultApp.secrets.types.jwt_key}</option>
                        <option value="paseto_key">${i18n.vaultApp.secrets.types.paseto_key}</option>
                    </select>
                    <p class="vnw-hint">${i18n.vaultApp.secrets.typeHint}</p>

                    <label class="vnw-label" for="va-sec-source">${i18n.vaultApp.secrets.sourceLabel}</label>
                    <select id="va-sec-source" class="vnw-input va-select" @bind={vaSecSource}>
                        <option value="static">${i18n.vaultApp.secrets.sourceStatic}</option>
                        <option value="reference">${i18n.vaultApp.secrets.sourceReference}</option>
                    </select>

                    @if vaSecSource == "reference"
                        <label class="vnw-label" for="va-sec-ref">${i18n.vaultApp.secrets.refLabel}</label>
                        <select id="va-sec-ref" class="vnw-input va-select" @bind={vaSecRef}>
                            <option value=""></option>
                            @for s in vaRefCandidates(vaSecrets, vaSecType)
                                <option value="${s.id}">${s.name}</option>
                            @end
                        </select>
                        <p class="vnw-hint">${i18n.vaultApp.secrets.refHint}</p>
                    @else
                        <label class="vnw-label" for="va-sec-value">${i18n.vaultApp.secrets.valueLabel}</label>
                        <textarea id="va-sec-value" class="vnw-input va-textarea" rows="4" autocomplete="off" spellcheck="false" placeholder="${i18n.vaultApp.secrets.valuePlaceholder}" @bind={vaSecValue}></textarea>
                        <p class="vnw-hint">${i18n.vaultApp.secrets.valueHint}</p>
                    @end

                    @if vaFormErr == "name"
                        <p class="vnw-error">${i18n.vaultApp.secrets.errors.name}</p>
                    @end
                    @if vaFormErr == "conflict"
                        <p class="vnw-error">${i18n.vaultApp.secrets.errors.conflict}</p>
                    @end
                    @if vaFormErr == "value"
                        <p class="vnw-error">${i18n.vaultApp.secrets.errors.value} ${vaFormDetail}</p>
                    @end
                    @if vaFormErr == "reference"
                        <p class="vnw-error">${i18n.vaultApp.secrets.errors.reference} ${vaFormDetail}</p>
                    @end
                    @if vaFormErr == "forbidden"
                        <p class="vnw-error">${i18n.vaultApp.forbidden}</p>
                    @end
                    @if vaFormErr == "network"
                        <p class="vnw-error">${i18n.vaultApp.network}</p>
                    @end
                    @if vaFormErr == "unknown"
                        <p class="vnw-error">${i18n.vaultApp.unknown} ${vaFormDetail}</p>
                    @end
                </div>
                <div class="vnw-actions">
                    <button class="vnw-btn vnw-btn-ghost" type="button" @click={vaClose}>${i18n.vaultApp.cancel}</button>
                    @if vaBusy
                        <button class="vnw-btn vnw-btn-primary" type="submit" disabled>${i18n.vaultApp.saving}</button>
                    @else
                        @if vaSecretReady()
                            <button class="vnw-btn vnw-btn-primary" type="submit">${i18n.vaultApp.save}</button>
                        @else
                            <button class="vnw-btn vnw-btn-primary" type="submit" disabled>${i18n.vaultApp.save}</button>
                        @end
                    @end
                </div>
            </form>
        @end

        @if vaDrawer == "version"
            <form class="vnw-form" @submit={vaSubmitVersion(event)}>
                <div class="vnw-scroll">
                    @if vaTarget
                        <p class="vnw-subtitle"><code class="va-key">${vaTarget.name}</code> · v${vaTarget.version}</p>
                    @end
                    <label class="vnw-label" for="va-ver-value">${i18n.vaultApp.secrets.versionLabel}</label>
                    <textarea id="va-ver-value" class="vnw-input va-textarea va-focus" rows="4" autocomplete="off" spellcheck="false" @bind={vaSecValue}></textarea>
                    <p class="vnw-hint">${i18n.vaultApp.secrets.versionHint}</p>
                    @if vaFormErr == "value"
                        <p class="vnw-error">${i18n.vaultApp.secrets.errors.value} ${vaFormDetail}</p>
                    @end
                    @if vaFormErr == "forbidden"
                        <p class="vnw-error">${i18n.vaultApp.forbidden}</p>
                    @end
                    @if vaFormErr == "network"
                        <p class="vnw-error">${i18n.vaultApp.network}</p>
                    @end
                    @if vaFormErr == "unknown"
                        <p class="vnw-error">${i18n.vaultApp.unknown} ${vaFormDetail}</p>
                    @end
                </div>
                <div class="vnw-actions">
                    <button class="vnw-btn vnw-btn-ghost" type="button" @click={vaClose}>${i18n.vaultApp.cancel}</button>
                    @if vaBusy
                        <button class="vnw-btn vnw-btn-primary" type="submit" disabled>${i18n.vaultApp.saving}</button>
                    @else
                        @if vaSecValue != ""
                            <button class="vnw-btn vnw-btn-primary" type="submit">${i18n.vaultApp.save}</button>
                        @else
                            <button class="vnw-btn vnw-btn-primary" type="submit" disabled>${i18n.vaultApp.save}</button>
                        @end
                    @end
                </div>
            </form>
        @end

        @if vaDrawer == "rename"
            <form class="vnw-form" @submit={vaSubmitRename(event)}>
                <div class="vnw-scroll">
                    <label class="vnw-label" for="va-ren-name">${i18n.vaultApp.secrets.renameLabel}</label>
                    <input id="va-ren-name" class="vnw-input va-focus" type="text" autocomplete="off" spellcheck="false" maxlength="128" @bind={vaSecName}>
                    <p class="vnw-hint ${ruleClass(vaSecName, isSecretName(vaSecName), 'va-hint')}">${i18n.vaultApp.secrets.nameHint}</p>
                    @if vaFormErr == "name"
                        <p class="vnw-error">${i18n.vaultApp.secrets.errors.name}</p>
                    @end
                    @if vaFormErr == "conflict"
                        <p class="vnw-error">${i18n.vaultApp.secrets.errors.conflict}</p>
                    @end
                    @if vaFormErr == "forbidden"
                        <p class="vnw-error">${i18n.vaultApp.forbidden}</p>
                    @end
                    @if vaFormErr == "network"
                        <p class="vnw-error">${i18n.vaultApp.network}</p>
                    @end
                    @if vaFormErr == "unknown"
                        <p class="vnw-error">${i18n.vaultApp.unknown} ${vaFormDetail}</p>
                    @end
                </div>
                <div class="vnw-actions">
                    <button class="vnw-btn vnw-btn-ghost" type="button" @click={vaClose}>${i18n.vaultApp.cancel}</button>
                    @if vaBusy
                        <button class="vnw-btn vnw-btn-primary" type="submit" disabled>${i18n.vaultApp.saving}</button>
                    @else
                        @if isSecretName(vaSecName)
                            <button class="vnw-btn vnw-btn-primary" type="submit">${i18n.vaultApp.save}</button>
                        @else
                            <button class="vnw-btn vnw-btn-primary" type="submit" disabled>${i18n.vaultApp.save}</button>
                        @end
                    @end
                </div>
            </form>
        @end

        @if vaDrawer == "token"
            @if vaNewToken
                <div class="vnw-form">
                    <div class="vnw-scroll">
                        <p class="vnw-subtitle">${i18n.vaultApp.tokens.created}</p>
                        <p class="vnw-error">${i18n.vaultApp.tokens.once}</p>

                        <label class="vnw-label">${i18n.vaultApp.tokens.uriLabel}</label>
                        <div class="va-secret-box">
                            <code class="va-value-text">${vaNewToken.uri}</code>
                            <button class="vnw-copy" type="button" @click={vaCopy("uri", vaNewToken.uri || "")}>
                                @if vaCopied == "uri"
                                    <span class="vnw-copy-tag vnw-copy-done">${i18n.vaultApp.copied}</span>
                                @else
                                    <span class="vnw-copy-tag">${i18n.vaultApp.copy}</span>
                                @end
                            </button>
                        </div>

                        <label class="vnw-label">${i18n.vaultApp.tokens.tokenLabel}</label>
                        <div class="va-secret-box">
                            <code class="va-value-text">${vaNewToken.token}</code>
                            <button class="vnw-copy" type="button" @click={vaCopy("token", vaNewToken.token || "")}>
                                @if vaCopied == "token"
                                    <span class="vnw-copy-tag vnw-copy-done">${i18n.vaultApp.copied}</span>
                                @else
                                    <span class="vnw-copy-tag">${i18n.vaultApp.copy}</span>
                                @end
                            </button>
                        </div>
                    </div>
                    <div class="vnw-actions">
                        <button class="vnw-btn vnw-btn-primary" type="button" @click={vaClose}>${i18n.vaultApp.close}</button>
                    </div>
                </div>
            @else
                <form class="vnw-form" @submit={vaSubmitToken(event)}>
                    <div class="vnw-scroll">
                        @if vaOwnerLabel() != ""
                            <p class="vnw-subtitle">${i18n.vaultApp.secrets.owner} <code class="va-mono">${vaOwnerLabel()}</code></p>
                        @end
                        <label class="vnw-label" for="va-tok-name">${i18n.vaultApp.tokens.nameLabel}</label>
                        <input id="va-tok-name" class="vnw-input va-focus" type="text" autocomplete="off" spellcheck="false" maxlength="100" placeholder="${i18n.vaultApp.tokens.namePlaceholder}" @bind={vaTokName}>
                        <p class="vnw-hint">${i18n.vaultApp.tokens.nameHint}</p>

                        <label class="vnw-label" for="va-tok-exp">${i18n.vaultApp.tokens.expiresLabel}</label>
                        <select id="va-tok-exp" class="vnw-input va-select" @bind={vaTokExpires}>
                            <option value="">${i18n.vaultApp.tokens.expiresNever}</option>
                            <option value="7d">${i18n.vaultApp.tokens.d7}</option>
                            <option value="30d">${i18n.vaultApp.tokens.d30}</option>
                            <option value="90d">${i18n.vaultApp.tokens.d90}</option>
                            <option value="1y">${i18n.vaultApp.tokens.y1}</option>
                        </select>

                        @if vaFormErr == "forbidden"
                            <p class="vnw-error">${i18n.vaultApp.forbidden}</p>
                        @end
                        @if vaFormErr == "network"
                            <p class="vnw-error">${i18n.vaultApp.network}</p>
                        @end
                        @if vaFormErr == "name" || vaFormErr == "unknown" || vaFormErr == "conflict"
                            <p class="vnw-error">${i18n.vaultApp.unknown} ${vaFormDetail}</p>
                        @end
                    </div>
                    <div class="vnw-actions">
                        <button class="vnw-btn vnw-btn-ghost" type="button" @click={vaClose}>${i18n.vaultApp.cancel}</button>
                        @if vaBusy
                            <button class="vnw-btn vnw-btn-primary" type="submit" disabled>${i18n.vaultApp.saving}</button>
                        @else
                            @if isTokenName(vaTokName)
                                <button class="vnw-btn vnw-btn-primary" type="submit">${i18n.vaultApp.tokens.create}</button>
                            @else
                                <button class="vnw-btn vnw-btn-primary" type="submit" disabled>${i18n.vaultApp.tokens.create}</button>
                            @end
                        @end
                    </div>
                </form>
            @end
        @end

        @if vaDrawer == "invite"
            @if vaNewInvite != ""
                <div class="vnw-form">
                    <div class="vnw-scroll">
                        <p class="vnw-subtitle">${i18n.vaultApp.members.link}</p>
                        <p class="vnw-error">${i18n.vaultApp.members.once}</p>
                        <div class="va-secret-box">
                            <code class="va-value-text">${vaNewInvite}</code>
                            <button class="vnw-copy" type="button" @click={vaCopy("invite", vaNewInvite)}>
                                @if vaCopied == "invite"
                                    <span class="vnw-copy-tag vnw-copy-done">${i18n.vaultApp.copied}</span>
                                @else
                                    <span class="vnw-copy-tag">${i18n.vaultApp.copy}</span>
                                @end
                            </button>
                        </div>
                    </div>
                    <div class="vnw-actions">
                        <button class="vnw-btn vnw-btn-primary" type="button" @click={vaClose}>${i18n.vaultApp.close}</button>
                    </div>
                </div>
            @else
                <form class="vnw-form" @submit={vaSubmitInvite(event)}>
                    <div class="vnw-scroll">
                        <p class="vnw-subtitle">${i18n.vaultApp.members.invitesText}</p>
                        <label class="vnw-label" for="va-inv-email">${i18n.vaultApp.members.emailLabel}</label>
                        <input id="va-inv-email" class="vnw-input va-focus" type="email" autocomplete="off" spellcheck="false" placeholder="${i18n.vaultApp.members.emailPlaceholder}" @bind={vaInvEmail}>

                        <label class="vnw-label" for="va-inv-role">${i18n.vaultApp.members.roleLabel}</label>
                        <select id="va-inv-role" class="vnw-input va-select" @bind={vaInvRole}>
                            <option value="developer">${i18n.vaultApp.roles.developer}</option>
                            <option value="admin">${i18n.vaultApp.roles.admin}</option>
                        </select>

                        @if vaFormErr == "email"
                            <p class="vnw-error">${i18n.vaultApp.members.errors.email}</p>
                        @end
                        @if vaFormErr == "conflict"
                            <p class="vnw-error">${i18n.vaultApp.members.errors.conflict}</p>
                        @end
                        @if vaFormErr == "forbidden"
                            <p class="vnw-error">${i18n.vaultApp.forbidden}</p>
                        @end
                        @if vaFormErr == "network"
                            <p class="vnw-error">${i18n.vaultApp.network}</p>
                        @end
                        @if vaFormErr == "unknown" || vaFormErr == "name"
                            <p class="vnw-error">${i18n.vaultApp.unknown} ${vaFormDetail}</p>
                        @end
                    </div>
                    <div class="vnw-actions">
                        <button class="vnw-btn vnw-btn-ghost" type="button" @click={vaClose}>${i18n.vaultApp.cancel}</button>
                        @if vaBusy
                            <button class="vnw-btn vnw-btn-primary" type="submit" disabled>${i18n.vaultApp.saving}</button>
                        @else
                            @if isEmail(vaInvEmail)
                                <button class="vnw-btn vnw-btn-primary" type="submit">${i18n.vaultApp.members.send}</button>
                            @else
                                <button class="vnw-btn vnw-btn-primary" type="submit" disabled>${i18n.vaultApp.members.send}</button>
                            @end
                        @end
                    </div>
                </form>
            @end
        @end
    </aside>
</div>
