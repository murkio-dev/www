<script>
    // Rota dinâmica /vault/:id/:app: uma aplicação do Vault. Sem sessão, manda para /authentication.
    //   pierrot test "src/pages/vault/[id]/[app]" -t "^Component"
    import en from "../../../../i18n/en-us.json";

    function ComponentWithoutSessionRedirectsToAuthentication(target) {
        target.Goto("/vault/42/minha-app");
        expect().toBeOnUrl(/\/en-us\/authentication\?next=/);
        expect().toHaveText(en.auth.login.title).onClass("au-title");
    }

    function ComponentNestedRouteIsNotA404(target) {
        target.Goto("/vault/42/01a19d33-557d-77c0-a3a5-297106771a2c");
        expect().toHaveCount(0).onClass("error-title");
    }
</script>
