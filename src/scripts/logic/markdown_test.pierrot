<script>
    import { mdBlocks } from "./markdown.ts";

    function UnitMarkdownEmpty() {
        expect(mdBlocks("")).toEqual([]);
        expect(mdBlocks(undefined)).toEqual([]);
        expect(mdBlocks("\n\n   \n")).toEqual([]);
    }

    function UnitMarkdownParagraph() {
        const blocks = mdBlocks("Olá mundo");
        expect(blocks).toHaveLength(1);
        expect(blocks[0].type).toBe("p");
        expect(blocks[0].segs).toEqual([{ kind: "t", text: "Olá mundo" }]);
        expect(blocks[0].items).toEqual([]);
    }

    function UnitMarkdownJoinsConsecutiveLines() {
        const blocks = mdBlocks("primeira\nsegunda\n  terceira  ");
        expect(blocks).toHaveLength(1);
        expect(blocks[0].segs).toEqual([{ kind: "t", text: "primeira segunda terceira" }]);
    }

    function UnitMarkdownBlankLineSplitsParagraphs() {
        const blocks = mdBlocks("um\n\ndois");
        expect(blocks).toHaveLength(2);
        expect(blocks[0].segs[0].text).toBe("um");
        expect(blocks[1].segs[0].text).toBe("dois");
    }

    function UnitMarkdownInline() {
        const segs = mdBlocks("a **negrito** b *itálico* c `código` d")[0].segs;
        expect(segs).toEqual([
            { kind: "t", text: "a " },
            { kind: "b", text: "negrito" },
            { kind: "t", text: " b " },
            { kind: "i", text: "itálico" },
            { kind: "t", text: " c " },
            { kind: "c", text: "código" },
            { kind: "t", text: " d" },
        ]);
    }

    function UnitMarkdownInlineAtEdges() {
        const segs = mdBlocks("**tudo**")[0].segs;
        expect(segs).toEqual([{ kind: "b", text: "tudo" }]);
    }

    function UnitMarkdownInlineUnclosedStaysText() {
        const segs = mdBlocks("texto **aberto sem fechar")[0].segs;
        expect(segs).toEqual([{ kind: "t", text: "texto **aberto sem fechar" }]);
        expect(mdBlocks("crase ` solta")[0].segs[0].kind).toBe("t");
    }

    function UnitMarkdownTwoLoneAsterisksBecomeItalic() {
        // comportamento atual: um par de `*` vira itálico, mesmo em "2 * 3 * 4"
        const segs = mdBlocks("2 * 3 * 4")[0].segs;
        expect(segs.map(s => s.kind)).toEqual(["t", "i", "t"]);
    }

    function UnitMarkdownHeadings() {
        for (const prefix of ["#", "##", "###"]) {
            const blocks = mdBlocks(prefix + " Título");
            expect(blocks).toHaveLength(1);
            expect(blocks[0].type).toBe("h");
            expect(blocks[0].segs).toEqual([{ kind: "t", text: "Título" }]);
        }
    }

    function UnitMarkdownHeadingNeedsSpace() {
        expect(mdBlocks("#semEspaco")[0].type).toBe("p");
    }

    function UnitMarkdownHeadingLevelFourIsParagraph() {
        expect(mdBlocks("#### fundo")[0].type).toBe("p");
    }

    function UnitMarkdownHeadingWithInline() {
        const segs = mdBlocks("## Plano **Pro**")[0].segs;
        expect(segs).toEqual([
            { kind: "t", text: "Plano " },
            { kind: "b", text: "Pro" },
        ]);
    }

    function UnitMarkdownList() {
        const blocks = mdBlocks("- um\n* dois\n- três **x**");
        expect(blocks).toHaveLength(1);
        expect(blocks[0].type).toBe("ul");
        expect(blocks[0].segs).toEqual([]);
        expect(blocks[0].items).toHaveLength(3);
        expect(blocks[0].items[0]).toEqual([{ kind: "t", text: "um" }]);
        expect(blocks[0].items[1]).toEqual([{ kind: "t", text: "dois" }]);
        expect(blocks[0].items[2]).toEqual([
            { kind: "t", text: "três " },
            { kind: "b", text: "x" },
        ]);
    }

    function UnitMarkdownParagraphThenList() {
        const blocks = mdBlocks("Para validar.\n\n- E-mail\n- Login social");
        expect(blocks.map(b => b.type)).toEqual(["p", "ul"]);
        expect(blocks[1].items).toHaveLength(2);
    }

    function UnitMarkdownListWithoutBlankLineAfterParagraph() {
        const blocks = mdBlocks("intro\n- item");
        expect(blocks.map(b => b.type)).toEqual(["p", "ul"]);
    }

    function UnitMarkdownTextAfterListClosesList() {
        const blocks = mdBlocks("- item\ndepois");
        expect(blocks.map(b => b.type)).toEqual(["ul", "p"]);
        expect(blocks[1].segs[0].text).toBe("depois");
    }

    function UnitMarkdownDashNeedsSpace() {
        expect(mdBlocks("-colado")[0].type).toBe("p");
    }

    function UnitMarkdownPlanDescription() {
        const blocks = mdBlocks("Para produtos em crescimento.\n\n- Tudo do **Free**\n- Suporte `prioritário`");
        expect(blocks.map(b => b.type)).toEqual(["p", "ul"]);
        expect(blocks[1].items[0][1]).toEqual({ kind: "b", text: "Free" });
        expect(blocks[1].items[1][1]).toEqual({ kind: "c", text: "prioritário" });
    }

    function UnitMarkdownIsRepeatable() {
        // o regex de inline é global e compartilhado: chamadas seguidas não podem vazar estado
        const a = mdBlocks("**x** e *y*");
        const b = mdBlocks("**x** e *y*");
        expect(b).toEqual(a);
    }
</script>
