<script>
    let href: string;
    let label: string;
    function goLogin(url: string): void {
        client.Redirect(url);
    }
</script>

<button class="login" @click={goLogin(href)}>${label}</button>

<style>
    .login {
        flex: none;
        white-space: nowrap;
        border: 0;
        cursor: pointer;
        display: flex;
        align-items: center;
        height: 36px;
        padding: 0 8px;
        font-family: "Jaldi", sans-serif;
        font-size: 18px;
        color: rgb(var(--m-fg));
        text-decoration: none;
        background: transparent;
    }

    .login:hover {
        opacity: 0.75;
    }
</style>
