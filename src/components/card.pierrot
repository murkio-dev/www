<script>
    // type: "cap" (recurso com 3 tags), "sdk" (SDK com comando), "faq" (pergunta e resposta),
    // "infra" (serviço do diagrama), "gateway" (gateway do router) ou "feature" (recurso do Vault).
    // Cada tipo usa só as props dele.
    let type: string;
    let icon: string;
    let title: string;
    let text: string;
    let t1: string;
    let t2: string;
    let t3: string;
    let logo: string;
    let name: string;
    let command: string;
    let soon: string;
    let question: string;
    let answer: string;
    let initial: string;
    let label: string;
    let description: string;
</script>

@if type == "cap"
    <article class="idn-cap">
        <span class="idn-cap-icon"><img src="${icon}" alt="" width="20" height="20"></span>
        <h3 class="idn-cap-title">${title}</h3>
        <p class="idn-cap-text">${text}</p>
        <ul class="idn-cap-tags">
            <li class="idn-cap-tag">${t1}</li>
            <li class="idn-cap-tag">${t2}</li>
            <li class="idn-cap-tag">${t3}</li>
        </ul>
    </article>
@end
@if type == "sdk"
    <article class="idn-sdk">
        <div class="idn-sdk-top">
            <span class="idn-sdk-logo"><img src="${logo}" alt="" width="26" height="26"></span>
            <span class="cs"><span class="cs-dot"></span><span>${soon}</span></span>
        </div>
        <h3 class="idn-sdk-name">${name}</h3>
        <code class="idn-sdk-cmd">${command}</code>
    </article>
@end
@if type == "faq"
    <details class="idn-faq">
        <summary class="idn-faq-q">
            <span>${question}</span>
            <span class="idn-faq-plus" aria-hidden="true"></span>
        </summary>
        <p class="idn-faq-a">${answer}</p>
    </details>
@end
@if type == "infra"
    <div class="infra-card">
        <span class="infra-card-icon"><img src="${icon}" alt="" width="18" height="18"></span>
        <span class="infra-card-title">${title}</span>
    </div>
@end
@if type == "gateway"
    <div class="rg">
        <span class="rg-initial">${initial}</span>
        <span class="rg-name">${name}</span>
    </div>
@end
@if type == "feature"
    <div class="vf">
        <span class="vf-icon"><img src="${icon}" alt="" width="22" height="22"></span>
        <h3 class="vf-label">${label}</h3>
        <p class="vf-description">${description}</p>
    </div>
@end

<style>
    .idn-cap {
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        gap: 12px;
        box-sizing: border-box;
        padding: 26px;
        border: 1px solid rgb(var(--m-fg) / 0.08);
        border-radius: 22px;
        transition: border-color 0.2s ease, transform 0.2s ease;
        background-image: var(--m-noise), linear-gradient(119.2deg, color-mix(in srgb, #0f0d0d calc(var(--m-dark) * 100%), var(--m-l0)) 0%, color-mix(in srgb, #241b1b calc(var(--m-dark) * 100%), var(--m-l1)) 100%);
    }

    .idn-cap::before {
        content: "";
        position: absolute;
        top: -60px;
        right: -60px;
        width: 180px;
        height: 180px;
        border-radius: 50%;
        opacity: 0;
        transition: opacity 0.3s ease;
        pointer-events: none;
        background: radial-gradient(closest-side, rgb(var(--m-rose) / 0.28), transparent);
    }

    .idn-cap:hover {
        border-color: rgb(var(--m-rose) / 0.4);
        transform: translateY(-2px);
    }

    .idn-cap:hover::before {
        opacity: 1;
    }

    .idn-cap-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        margin-bottom: 8px;
        border: 1px solid rgb(var(--m-fg) / 0.12);
        border-radius: 12px;
        background-color: rgb(var(--m-fg) / 0.05);
    }

    .idn-cap-title {
        font-family: "Roboto", sans-serif;
        font-weight: 400;
        font-size: 20px;
        line-height: 1.2;
        color: rgb(var(--m-fg));
        background: transparent;
    }

    .idn-cap-text {
        font-family: "Roboto", sans-serif;
        font-size: 14.5px;
        line-height: 1.55;
        color: rgb(var(--m-fg) / 0.62);
        background: transparent;
    }

    .idn-cap-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin: auto 0 0;
        padding: 14px 0 0;
        list-style: none;
        background: transparent;
    }

    .idn-cap-tag {
        padding: 4px 10px;
        border: 1px solid rgb(var(--m-fg) / 0.12);
        border-radius: 8px;
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
        color: rgb(var(--m-fg) / 0.7);
        background-color: rgb(var(--m-fg) / 0.04);
    }

    .idn-sdk {
        display: flex;
        flex-direction: column;
        gap: 10px;
        box-sizing: border-box;
        min-width: 0;
        padding: 20px;
        border: 1px solid rgb(var(--m-fg) / 0.08);
        border-radius: 18px;
        transition: border-color 0.2s ease;
        background-image: var(--m-noise), linear-gradient(119.2deg, color-mix(in srgb, #0f0d0d calc(var(--m-dark) * 100%), var(--m-l0)) 0%, color-mix(in srgb, #1c1515 calc(var(--m-dark) * 100%), var(--m-l1)) 100%);
    }

    .idn-sdk:hover {
        border-color: rgb(var(--m-rose) / 0.35);
    }

    .idn-sdk-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        background: transparent;
    }

    .idn-sdk-logo {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border: 1px solid rgb(var(--m-fg) / 0.12);
        border-radius: 12px;
        background-color: rgb(var(--m-fg) / 0.05);
    }

    .idn-sdk-logo img {
        filter: brightness(0) invert(var(--m-dark));
        opacity: 0.85;
    }

    .idn-sdk-name {
        font-family: "Roboto", sans-serif;
        font-weight: 400;
        font-size: 18px;
        color: rgb(var(--m-fg));
        background: transparent;
    }

    .idn-sdk-cmd {
        display: block;
        overflow-x: auto;
        padding: 10px 12px;
        border: 1px solid rgb(var(--m-fg) / 0.1);
        border-radius: 10px;
        white-space: nowrap;
        font-family: "JetBrains Mono", monospace;
        font-size: 12px;
        color: rgb(var(--m-rose-hi));
        background-color: rgb(var(--m-well) / 0.6);
    }

    .idn-faq {
        border-bottom: 1px solid rgb(var(--m-fg) / 0.12);
        background: transparent;
    }

    .idn-faq-q {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 22px 0;
        cursor: pointer;
        list-style: none;
        font-family: "Roboto", sans-serif;
        font-size: 18px;
        color: rgb(var(--m-fg));
        background: transparent;
    }

    .idn-faq-q::-webkit-details-marker {
        display: none;
    }

    .idn-faq-q:hover {
        color: rgb(var(--m-rose-hi));
    }

    .idn-faq-plus {
        position: relative;
        flex: none;
        width: 14px;
        height: 14px;
        background: transparent;
    }

    .idn-faq-plus::before,
    .idn-faq-plus::after {
        content: "";
        position: absolute;
        top: 6px;
        left: 0;
        width: 14px;
        height: 1.5px;
        transition: transform 0.2s ease;
        background-color: rgb(var(--m-rose));
    }

    .idn-faq-plus::after {
        transform: rotate(90deg);
    }

    .idn-faq[open] .idn-faq-plus::after {
        transform: rotate(0deg);
    }

    .idn-faq-a {
        max-width: 760px;
        padding: 0 0 24px;
        font-family: "Roboto", sans-serif;
        font-size: 15.5px;
        line-height: 1.6;
        color: rgb(var(--m-fg) / 0.62);
        background: transparent;
    }

    .cs {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 11px 4px 9px;
        border: 1px solid rgb(var(--m-orange) / 0.5);
        border-radius: 999px;
        font-family: "Jaldi", sans-serif;
        font-size: 14px;
        color: rgb(var(--m-orange));
        background-color: rgb(var(--m-orange) / 0.12);
    }

    .cs-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        box-shadow: 0 0 8px rgb(var(--m-orange) / 0.9);
        background-color: rgb(var(--m-orange));
    }

    .infra-card {
        position: relative;
        display: flex;
        align-items: center;
        gap: 12px;
        box-sizing: border-box;
        height: 56px;
        padding: 0 16px;
        border: 1px solid rgb(var(--m-fg) / 0.12);
        border-radius: 12px;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
        transition: border-color 0.2s ease, transform 0.2s ease;
        background-image: var(--m-noise), linear-gradient(243.8deg, rgb(var(--m-fg) / 0.1) 10.2%, rgba(113, 113, 113, 0.05) 92.6%);
    }

    .infra-card:hover {
        border-color: rgb(var(--m-rose-2) / 0.5);
        transform: translateX(3px);
    }

    .infra-card::before {
        content: "";
        position: absolute;
        top: 50%;
        left: -5px;
        width: 6px;
        height: 6px;
        margin-top: -4px;
        border: 1.5px solid rgb(var(--m-rose) / 0.95);
        border-radius: 50%;
        background-color: color-mix(in srgb, #0a0a0a calc(var(--m-dark) * 100%), var(--m-l0));
    }

    .infra-card-icon {
        display: flex;
        flex: none;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border: 1px solid rgb(var(--m-fg) / 0.12);
        border-radius: 8px;
        background: transparent;
    }

    .infra-card-title {
        font-family: "Jaldi", sans-serif;
        font-size: 18px;
        color: rgb(var(--m-fg));
        background: transparent;
    }

    .rg {
        position: relative;
        display: flex;
        align-items: center;
        gap: 12px;
        box-sizing: border-box;
        height: 56px;
        padding: 0 16px;
        border: 1px solid rgb(var(--m-fg) / 0.12);
        border-radius: 12px;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
        transition: border-color 0.2s ease, transform 0.2s ease;
        background-image: var(--m-noise), linear-gradient(243.8deg, rgb(var(--m-fg) / 0.1) 10.2%, rgba(113, 113, 113, 0.05) 92.6%);
    }

    .rg:hover {
        border-color: rgb(var(--m-rose-2) / 0.5);
        transform: translateX(3px);
    }

    .rg::before {
        content: "";
        position: absolute;
        top: 50%;
        left: -5px;
        width: 6px;
        height: 6px;
        margin-top: -4px;
        border: 1.5px solid rgb(var(--m-rose) / 0.95);
        border-radius: 50%;
        background-color: color-mix(in srgb, #0a0a0a calc(var(--m-dark) * 100%), var(--m-l0));
    }

    .rg-initial {
        display: flex;
        flex: none;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border: 1px solid rgb(var(--m-fg) / 0.14);
        border-radius: 8px;
        font-family: "Jaldi", sans-serif;
        font-size: 16px;
        color: rgb(var(--m-rose-hi));
        background: transparent;
    }

    .rg-name {
        font-family: "Jaldi", sans-serif;
        font-size: 18px;
        color: rgb(var(--m-fg));
        background: transparent;
    }

    .vf {
        display: flex;
        flex-direction: column;
        gap: 12px;
        box-sizing: border-box;
        min-height: 220px;
        padding: 28px;
        border: 1px solid rgb(var(--m-fg) / 0.08);
        border-radius: 28px;
        background-image: var(--m-noise), linear-gradient(119.2deg, color-mix(in srgb, #0f0d0d calc(var(--m-dark) * 100%), var(--m-l0)) 0%, color-mix(in srgb, #241b1b calc(var(--m-dark) * 100%), var(--m-l1)) 100%);
    }

    .vf-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        margin-bottom: auto;
        border: 1px solid rgb(var(--m-fg) / 0.2);
        border-radius: 12px;
        background-image: linear-gradient(243.8deg, rgb(var(--m-fg) / 0.14) 10.2%, rgba(113, 113, 113, 0.08) 92.6%);
    }

    .vf-label {
        font-family: "Roboto", sans-serif;
        font-weight: 400;
        font-size: 22px;
        line-height: 1.2;
        color: rgb(var(--m-fg));
        background: transparent;
    }

    .vf-description {
        font-family: "Roboto", sans-serif;
        font-size: 15px;
        line-height: 1.5;
        color: rgb(var(--m-fg) / 0.62);
        background: transparent;
    }
</style>
