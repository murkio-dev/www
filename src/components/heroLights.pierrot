<div class="lights" aria-hidden="true">
    <span class="light light-a"></span>
    <span class="light light-b"></span>
    <span class="light light-c"></span>

    <span class="dust"></span>

    <span class="streak streak-1"></span>
    <span class="streak streak-2"></span>
    <span class="streak streak-3"></span>
    <span class="streak streak-4"></span>
    <span class="streak streak-5"></span>
    <span class="streak streak-6"></span>
</div>

<style>
    .lights {
        position: absolute;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        background: transparent;
    }

    .light {
        position: absolute;
        border-radius: 50%;
        filter: blur(36px);
        will-change: transform;
    }

    .light-a {
        top: -22%;
        right: -12%;
        width: 58%;
        height: 78%;
        background: radial-gradient(closest-side, rgb(var(--m-rose) / 0.62) 0%, rgba(160, 126, 126, 0.32) 45%, rgba(115, 86, 86, 0) 100%);
        transform: rotate(-20deg);
        animation: light-drift-a 22s ease-in-out infinite alternate;
    }

    .light-b {
        bottom: -30%;
        left: -14%;
        width: 50%;
        height: 66%;
        background: radial-gradient(closest-side, rgba(190, 158, 158, 0.5) 0%, rgba(130, 98, 98, 0.26) 50%, rgba(115, 86, 86, 0) 100%);
        transform: rotate(14deg);
        animation: light-drift-b 26s ease-in-out infinite alternate;
    }

    .light-c {
        bottom: -18%;
        right: 8%;
        width: 30%;
        height: 34%;
        background: radial-gradient(closest-side, rgba(150, 112, 112, 0.34) 0%, rgba(115, 86, 86, 0) 100%);
        animation: light-drift-a 30s ease-in-out infinite alternate-reverse;
    }

    .dust {
        position: absolute;
        inset: 0;
        background-image:
            radial-gradient(1px 1px at 8% 22%, rgb(var(--m-fg) / 0.55), transparent),
            radial-gradient(1px 1px at 14% 68%, rgb(var(--m-fg) / 0.4), transparent),
            radial-gradient(1.5px 1.5px at 21% 41%, rgb(var(--m-fg) / 0.5), transparent),
            radial-gradient(1px 1px at 29% 84%, rgb(var(--m-fg) / 0.35), transparent),
            radial-gradient(1px 1px at 36% 16%, rgb(var(--m-fg) / 0.45), transparent),
            radial-gradient(1.5px 1.5px at 44% 74%, rgb(var(--m-fg) / 0.55), transparent),
            radial-gradient(1px 1px at 52% 90%, rgb(var(--m-fg) / 0.4), transparent),
            radial-gradient(1px 1px at 58% 28%, rgb(var(--m-fg) / 0.35), transparent),
            radial-gradient(1.5px 1.5px at 66% 62%, rgb(var(--m-fg) / 0.5), transparent),
            radial-gradient(1px 1px at 73% 12%, rgb(var(--m-fg) / 0.45), transparent),
            radial-gradient(1px 1px at 81% 46%, rgb(var(--m-fg) / 0.4), transparent),
            radial-gradient(1.5px 1.5px at 88% 80%, rgb(var(--m-fg) / 0.55), transparent),
            radial-gradient(1px 1px at 93% 33%, rgb(var(--m-fg) / 0.35), transparent),
            radial-gradient(1px 1px at 4% 92%, rgb(var(--m-fg) / 0.4), transparent);
        animation: dust-twinkle 6s ease-in-out infinite alternate;
    }

    .streak {
        position: absolute;
        bottom: 0;
        width: 1px;
        background-image: linear-gradient(180deg, rgb(var(--m-fg) / 0), rgb(var(--m-fg) / 0.85));
        animation: streak-glow 5s ease-in-out infinite alternate;
    }

    .streak-1 {
        left: calc(50% - 62px);
        height: 150px;
        opacity: 0.5;
    }

    .streak-2 {
        left: calc(50% - 38px);
        height: 110px;
        animation-delay: -1.2s;
    }

    .streak-3 {
        left: calc(50% - 14px);
        height: 190px;
        opacity: 0.35;
        animation-delay: -2.4s;
    }

    .streak-4 {
        left: calc(50% + 10px);
        height: 90px;
        animation-delay: -0.6s;
    }

    .streak-5 {
        left: calc(50% + 34px);
        height: 160px;
        opacity: 0.6;
        animation-delay: -3.1s;
    }

    .streak-6 {
        left: calc(50% + 58px);
        height: 120px;
        opacity: 0.4;
        animation-delay: -1.8s;
    }

    @keyframes light-drift-a {
        from { transform: rotate(-20deg) translate(0, 0); }
        to { transform: rotate(-14deg) translate(-3%, 4%); }
    }

    @keyframes light-drift-b {
        from { transform: rotate(14deg) translate(0, 0); }
        to { transform: rotate(8deg) translate(4%, -3%); }
    }

    @keyframes dust-twinkle {
        from { opacity: 0.55; }
        to { opacity: 1; }
    }

    @keyframes streak-glow {
        from { opacity: 0.25; }
        to { opacity: 0.9; }
    }

    @media (prefers-reduced-motion: reduce) {
        .light,
        .dust,
        .streak {
            animation: none;
        }
    }

    :root[data-theme="light"] .light {
        opacity: 0.45;
    }

    :root[data-theme="light"] .dust {
        opacity: 0.35;
    }

    :root[data-theme="light"] .streak {
        background-image: linear-gradient(180deg, rgb(var(--m-fg) / 0), rgb(var(--m-fg) / 0.55));
    }
</style>
