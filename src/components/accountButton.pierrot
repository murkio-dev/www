<script>
    let href: string;
    let label: string;
    function goAccount(url: string): void {
        client.Redirect(url);
    }
</script>

<button class="account" @click={goAccount(href)}>
    <img src="/assets/icons/ui/user.svg" alt="" width="20" height="22">
    <span class="account-label">${label}</span>
</button>

