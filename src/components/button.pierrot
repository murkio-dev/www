<script>
    let href: string;
    let label: string;
    let variant: string;
    function goButton(url: string): void {
        client.Redirect(url);
    }
</script>

<button class="button button-${variant}" @click={goButton(href)}>
    @if variant == "account"
        <img src="/assets/icons/ui/user.svg" alt="" width="16" height="16">
    @end
    ${label}
</button>

<style>
    .button {
        border: 0;
