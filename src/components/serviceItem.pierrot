<script>
    let href: string;
    let icon: string;
    let title: string;
    let description: string;
    let status: string;
    let statusLabel: string;

    function goService(url: string): void {
        client.Redirect(url);
    }
</script>

<button class="service-item" @click={goService(href)}>
    <span class="service-item-icon"><img src="${icon}" alt="" width="20" height="20"></span>
    <span class="service-item-text">
        <span class="service-item-head">
            <span class="service-item-title">${title}</span>
            <span class="service-flag service-flag-${status}"><span class="service-flag-dot"></span>${statusLabel}</span>
        </span>
        <span class="service-item-description">${description}</span>
    </span>
</button>

