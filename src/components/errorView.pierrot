<script>
    let code: string;

    function goHome(): void {
        client.Redirect("/");
    }
</script>

<main class="error">
    <div class="error-stage">
        <p class="error-code" aria-hidden="true">${code}</p>

        <section class="error-card">
            @if code == "400"
                <h1 class="error-title">${i18n.errors.badRequest.title}</h1>
                <p class="error-message">${i18n.errors.badRequest.message}</p>
            @end
            @if code == "401"
                <h1 class="error-title">${i18n.errors.unauthorized.title}</h1>
                <p class="error-message">${i18n.errors.unauthorized.message}</p>
            @end
            @if code == "403"
                <h1 class="error-title">${i18n.errors.forbidden.title}</h1>
                <p class="error-message">${i18n.errors.forbidden.message}</p>
            @end
            @if code == "404"
                <h1 class="error-title">${i18n.errors.notFound.title}</h1>
                <p class="error-message">${i18n.errors.notFound.message}</p>
            @end
            @if code == "408"
                <h1 class="error-title">${i18n.errors.timeout.title}</h1>
                <p class="error-message">${i18n.errors.timeout.message}</p>
            @end
            @if code == "429"
                <h1 class="error-title">${i18n.errors.tooManyRequests.title}</h1>
                <p class="error-message">${i18n.errors.tooManyRequests.message}</p>
            @end
            @if code == "500"
                <h1 class="error-title">${i18n.errors.serverError.title}</h1>
                <p class="error-message">${i18n.errors.serverError.message}</p>
            @end
            @if code == "502"
                <h1 class="error-title">${i18n.errors.badGateway.title}</h1>
                <p class="error-message">${i18n.errors.badGateway.message}</p>
            @end
            @if code == "503"
                <h1 class="error-title">${i18n.errors.unavailable.title}</h1>
                <p class="error-message">${i18n.errors.unavailable.message}</p>
            @end
            @if code == "504"
                <h1 class="error-title">${i18n.errors.gatewayTimeout.title}</h1>
                <p class="error-message">${i18n.errors.gatewayTimeout.message}</p>
            @end
            @if code != "400" && code != "401" && code != "403" && code != "404" && code != "408" && code != "429" && code != "500" && code != "502" && code != "503" && code != "504"
                <h1 class="error-title">${i18n.errors.unknown.title}</h1>
                <p class="error-message">${i18n.errors.unknown.message}</p>
            @end

            <button class="error-button" @click={goHome}>${i18n.errors.back}</button>
        </section>
    </div>
</main>

<style>
    .error {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        width: calc(100% - 40px);
        height: calc(100vh - var(--header-h) - 20px);
        height: calc(100dvh - var(--header-h) - 20px);
        min-height: 560px;
        margin: 0 auto 20px;
        padding: 32px 20px;
        border-radius: 28px;
        background-image: var(--m-noise), linear-gradient(119.2deg, color-mix(in srgb, #0a0b0c calc(var(--m-dark) * 100%), var(--m-l0)) 0%, color-mix(in srgb, #352929 calc(var(--m-dark) * 100%), var(--m-l2)) 100%);
    }

    .error-stage {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 100%;
        max-width: 760px;
        background: transparent;
    }

    .error-code {
        margin: 0;
        font-family: "Roboto", sans-serif;
        font-weight: 200;
        font-size: clamp(140px, 26vw, 320px);
        line-height: 0.9;
        letter-spacing: -0.02em;
        user-select: none;
        background-image: linear-gradient(100deg, #f2f2f2 5%, #9a9a9a 45%, #4a3a3a 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .error-card {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        box-sizing: border-box;
        width: min(560px, 100%);
        margin-top: calc(clamp(140px, 26vw, 320px) * -0.32);
        padding: 32px 28px 36px;
        border: 1px solid rgb(var(--m-fg) / 0.1);
        border-radius: 24px;
        text-align: center;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
        -webkit-backdrop-filter: blur(14px);
        backdrop-filter: blur(14px);
        background-image: var(--m-noise), linear-gradient(243.8deg, rgb(var(--m-fg) / 0.1) 10.2%, rgba(113, 113, 113, 0.06) 92.6%);
    }

    .error-title {
        font-family: "Roboto", sans-serif;
        font-weight: 400;
        font-size: clamp(24px, 3vw, 32px);
        color: rgb(var(--m-fg));
        background: transparent;
    }

    .error-message {
        max-width: 440px;
        margin-bottom: 12px;
        font-family: "Roboto", sans-serif;
        font-size: 16px;
        line-height: 1.45;
        color: rgb(var(--m-fg) / 0.65);
        background: transparent;
    }

    .error-button {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 132px;
        height: 44px;
        padding: 0 24px;
        border: 1px solid #c9c9c9;
        border-radius: 64px;
        font-family: "Jaldi", sans-serif;
        font-size: 18px;
        color: #000000;
        cursor: pointer;
        background-color: transparent;
        background-image: var(--m-noise), linear-gradient(180deg, #d9d9d9, #9e9e9e);
    }

    .error-button:hover {
        filter: brightness(1.15);
    }

    :root[data-theme="light"] .error-code {
        background-image: linear-gradient(100deg, #2a201c 5%, #7a6a62 45%, #c4b2a4 100%);
    }
</style>
