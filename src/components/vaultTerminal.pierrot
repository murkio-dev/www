<div class="vm" aria-hidden="true">
    <span class="vm-glow"></span>

    <div class="vm-window">
        <div class="vm-bar">
            <span class="vm-dot"></span>
            <span class="vm-dot"></span>
            <span class="vm-dot"></span>
            <span class="vm-title">${i18n.vault.term.title}</span>
        </div>

        <div class="vm-body">
            <div class="vm-line vm-line-rm"><span class="vm-sign">-</span><span class="vm-code">${i18n.vault.term.rm1}</span></div>
            <div class="vm-line vm-line-rm"><span class="vm-sign">-</span><span class="vm-code">${i18n.vault.term.rm2}</span></div>
            <div class="vm-line vm-line-rm"><span class="vm-sign">-</span><span class="vm-code">${i18n.vault.term.rm3}</span></div>
            <div class="vm-line vm-line-add"><span class="vm-sign">+</span><span class="vm-code">${i18n.vault.uri}</span></div>
            <div class="vm-line vm-line-add"><span class="vm-sign">+</span><span class="vm-code">${i18n.vault.token}</span></div>
        </div>
    </div>
</div>

<style>
    .vm {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 28px;
        box-sizing: border-box;
        background: transparent;
    }

    .vm-glow {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 70%;
        height: 60%;
        margin: -30% 0 0 -35%;
        border-radius: 50%;
        filter: blur(60px);
        background: radial-gradient(closest-side, rgb(var(--m-rose) / 0.22) 0%, rgba(150, 116, 116, 0.1) 60%, rgba(115, 86, 86, 0) 100%);
    }

    .vm-window {
        position: relative;
        width: 100%;
        max-width: 460px;
        overflow: hidden;
        border: 1px solid rgb(var(--m-fg) / 0.14);
        border-radius: 14px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
        background-color: rgb(var(--m-well) / 0.85);
    }

    .vm-bar {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 11px 14px;
        border-bottom: 1px solid rgb(var(--m-fg) / 0.08);
        background-color: rgb(var(--m-fg) / 0.04);
    }

    .vm-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background-color: rgb(var(--m-fg) / 0.2);
    }

    .vm-title {
        margin-left: 10px;
        font-family: "JetBrains Mono", monospace;
        font-size: 12px;
        color: rgb(var(--m-fg) / 0.55);
        background: transparent;
    }

    .vm-body {
        display: flex;
        flex-direction: column;
        padding: 12px 0;
        background: transparent;
    }

    .vm-line {
        display: flex;
        gap: 12px;
        padding: 6px 16px;
        font-family: "JetBrains Mono", monospace;
        font-size: 13px;
        line-height: 1.4;
        background: transparent;
    }

    .vm-sign {
        flex: none;
        width: 10px;
        background: transparent;
    }

    .vm-code {
        overflow-wrap: anywhere;
        background: transparent;
    }

    .vm-line-rm {
        background-color: rgba(200, 85, 61, 0.14);
    }

    .vm-line-rm .vm-sign {
        color: rgb(var(--m-warn));
    }

    .vm-line-rm .vm-code {
        color: rgb(var(--m-warn) / 0.75);
        text-decoration: line-through;
    }

    .vm-line-add {
        background-color: rgb(var(--m-ok) / 0.12);
    }

    .vm-line-add .vm-sign,
    .vm-line-add .vm-code {
        color: rgb(var(--m-ok));
    }
</style>
