<script>
    // Estado vazio de uma seção: ícone, título e texto. Os nomes têm o prefixo em*
    // porque os scripts de páginas e componentes dividem o mesmo escopo.
    let emIcon: string;
    let emTitle: string;
    let emText: string;
</script>

