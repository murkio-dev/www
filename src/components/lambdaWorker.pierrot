        padding: 13px 18px;
        font-family: "JetBrains Mono", monospace;
        font-size: 12px;
        color: rgb(var(--m-fg));
        background-color: rgb(var(--m-fg) / 0.05);
    }

    .lw-editor {
        display: flex;
        gap: 18px;
        padding: 22px 20px 26px;
        background: transparent;
    }

    .lw-gutter {
        display: flex;
        flex-direction: column;
        font-family: "JetBrains Mono", monospace;
        font-size: 13px;
        line-height: 1.8;
        text-align: right;
        color: rgb(var(--m-fg) / 0.25);
        user-select: none;
        background: transparent;
    }

    .lw-gutter span {
        background: transparent;
    }

    .lw-code {
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow-x: auto;
        font-family: "JetBrains Mono", monospace;
        font-size: 13px;
        line-height: 1.8;
        background: transparent;
    }

    .lw-line {
        white-space: pre;
        background: transparent;
    }

    .lw-in {
        padding-left: 22px;
    }

    .lw-line span {
        background: transparent;
    }

    .lw-kw { color: rgb(var(--m-rose-lo)); }
    .lw-fn { color: rgb(var(--m-rose-hi)); }
    .lw-str { color: rgb(var(--m-str)); }
    .lw-p { color: rgb(var(--m-fg) / 0.62); }

    .lw-head {
        padding: 13px 20px;
        border-bottom: 1px solid rgb(var(--m-fg) / 0.1);
