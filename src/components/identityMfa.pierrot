<div class="idm">
    <span class="idm-glow" aria-hidden="true"></span>

    <div class="idm-code" aria-hidden="true">
        <span class="idm-digit">4</span>
        <span class="idm-digit">8</span>
        <span class="idm-digit">2</span>
        <span class="idm-sep"></span>
        <span class="idm-digit">1</span>
        <span class="idm-digit">9</span>
        <span class="idm-digit">6</span>
    </div>

    <div class="idm-modes">
        <span class="idm-mode">${i18n.identity.mfa.modeOff}</span>
        <span class="idm-mode idm-mode-active">${i18n.identity.mfa.modeOptional}</span>
        <span class="idm-mode">${i18n.identity.mfa.modeRequired}</span>
    </div>

    <h3 class="id-title">${i18n.identity.mfa.title}</h3>
    <p class="id-text">${i18n.identity.mfa.description}</p>
</div>

<style>
    .idm {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 14px;
        height: 100%;
        background: transparent;
    }

    .idm-glow {
        position: absolute;
        top: -60px;
        left: -70px;
        width: 340px;
        height: 260px;
        border-radius: 50%;
        filter: blur(34px);
        background: radial-gradient(closest-side, rgba(232, 208, 208, 0.7) 0%, rgba(170, 134, 134, 0.34) 50%, rgba(115, 86, 86, 0) 100%);
    }

    .idm-code {
        position: relative;
        display: flex;
        align-items: center;
        gap: 6px;
        background: transparent;
    }

    .idm-digit {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 44px;
        border: 1px solid rgb(var(--m-fg) / 0.22);
        border-radius: 8px;
        font-family: "JetBrains Mono", monospace;
        font-size: 20px;
        color: rgb(var(--m-fg));
        background-color: rgb(var(--m-well) / 0.55);
    }

    .idm-sep {
        width: 8px;
        height: 1px;
        background-color: rgb(var(--m-fg) / 0.4);
    }

    .idm-modes {
        position: relative;
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: auto;
        background: transparent;
    }

    .idm-mode {
        padding: 4px 10px;
        border: 1px solid rgb(var(--m-fg) / 0.18);
        border-radius: 999px;
        font-family: "JetBrains Mono", monospace;
        font-size: 11px;
        color: rgb(var(--m-fg) / 0.7);
        background: transparent;
    }

    .idm-mode-active {
        color: #0a0a0a;
        border-color: #d9d9d9;
        background-color: #d9d9d9;
    }
</style>
