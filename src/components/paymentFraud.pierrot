<div class="pf" aria-hidden="true">
    <span class="pf-chip pf-ok"><span class="pf-dot"></span>${i18n.payments.fraud.ok}</span>
    <span class="pf-chip pf-review"><span class="pf-dot"></span>${i18n.payments.fraud.review}</span>
    <span class="pf-chip pf-blocked"><span class="pf-dot"></span>${i18n.payments.fraud.blocked}</span>
</div>

<style>
    .pf {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: auto;
        background: transparent;
    }

    .pf-chip {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 12px;
        border: 1px solid rgb(var(--m-fg) / 0.14);
        border-radius: 999px;
        font-family: "Jaldi", sans-serif;
        font-size: 15px;
        color: rgb(var(--m-fg));
        background-color: rgb(var(--m-well) / 0.5);
    }

    .pf-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
    }

    .pf-ok .pf-dot {
        background-color: rgb(var(--m-rose));
        box-shadow: 0 0 8px rgb(var(--m-rose) / 0.8);
    }

    .pf-review .pf-dot {
        background-color: rgb(var(--m-orange));
        box-shadow: 0 0 8px rgb(var(--m-orange) / 0.7);
    }

    .pf-blocked .pf-dot {
        background-color: #c8553d;
        box-shadow: 0 0 8px rgba(200, 85, 61, 0.7);
    }
</style>
