<div class="vt" aria-hidden="true">
    <div class="vt-row vt-head">
        <span>${i18n.vault.table.h1}</span>
        <span>${i18n.vault.table.h2}</span>
        <span>${i18n.vault.table.h3}</span>
    </div>
    <div class="vt-row">
        <span class="vt-name">${i18n.vault.env.name1}</span>
        <span class="vt-value">${i18n.vault.env.value}</span>
        <span class="vt-cell"><span class="vt-tag">${i18n.vault.env.rotative}</span></span>
    </div>
    <div class="vt-row">
        <span class="vt-name">${i18n.vault.env.name2}</span>
        <span class="vt-value">${i18n.vault.env.value}</span>
        <span class="vt-cell"><span class="vt-tag">${i18n.vault.env.rotative}</span></span>
    </div>
    <div class="vt-row">
        <span class="vt-name">${i18n.vault.env.name3}</span>
        <span class="vt-value">${i18n.vault.env.value}</span>
        <span class="vt-cell"></span>
    </div>
</div>

<style>
    .vt {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid rgb(var(--m-fg) / 0.12);
        border-radius: 14px;
        font-family: "JetBrains Mono", monospace;
        font-size: 12px;
        background-color: rgb(var(--m-well) / 0.55);
    }

    .vt-row {
        display: grid;
        grid-template-columns: 1.5fr 1fr 0.8fr;
        align-items: center;
        gap: 12px;
        padding: 11px 16px;
        border-top: 1px solid rgb(var(--m-fg) / 0.08);
        background: transparent;
    }

    .vt-head {
        border-top: 0;
        font-size: 11px;
        color: rgb(var(--m-fg) / 0.45);
        background-color: rgb(var(--m-fg) / 0.04);
    }

    .vt-name {
        color: rgb(var(--m-fg));
        background: transparent;
    }

    .vt-value {
        color: rgb(var(--m-fg) / 0.4);
        background: transparent;
    }

    .vt-cell {
        background: transparent;
    }

    .vt-tag {
        padding: 2px 9px;
        border-radius: 999px;
        font-size: 10px;
        color: rgb(var(--m-well));
        background-color: rgb(var(--m-rose));
    }
</style>
