        <li class="idp-line"><span class="idp-dot"></span>${i18n.identity.privacy.log2}</li>
        <li class="idp-line"><span class="idp-dot"></span>${i18n.identity.privacy.log3}</li>
        <li class="idp-line"><span class="idp-dot idp-dot-hot"></span>${i18n.identity.privacy.log4}</li>
    </ul>

    <h3 class="id-title">${i18n.identity.privacy.title}</h3>
    <p class="id-text">${i18n.identity.privacy.description}</p>
</div>

<style>
    .idp {
        display: flex;
        flex-direction: column;
        gap: 14px;
        height: 100%;
        background: transparent;
    }

    .idp-log {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: auto;
        padding: 0;
        list-style: none;
        background: transparent;
    }

    .idp-line {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        border: 1px solid rgb(var(--m-fg) / 0.1);
        border-radius: 8px;
        font-family: "JetBrains Mono", monospace;
        font-size: 12px;
        color: rgb(var(--m-fg) / 0.8);
        background-color: rgb(var(--m-well) / 0.5);
    }

    .idp-dot {
        flex: none;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background-color: rgb(var(--m-fg) / 0.45);
    }

    .idp-dot-hot {
        background-color: rgb(var(--m-rose));
        box-shadow: 0 0 8px rgb(var(--m-rose) / 0.8);
    }
</style>
