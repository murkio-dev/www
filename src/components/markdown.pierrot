<script>
    import { mdBlocks } from "../scripts/logic/markdown.ts";

    let source: string;
</script>

<div class="md">
    @for block in mdBlocks(source)
        @if block.type == "h"
            <h4 class="md-h">
                @for seg in block.segs
                <span class="md-${seg.kind}">${seg.text}</span>
                @end
            </h4>
        @end
        @if block.type == "p"
            <p class="md-p">
                @for seg in block.segs
                <span class="md-${seg.kind}">${seg.text}</span>
                @end
            </p>
        @end
        @if block.type == "ul"
            <ul class="md-ul">
                @for item in block.items
                    <li class="md-li"><span class="md-tick" aria-hidden="true"></span><span class="md-text">
                        @for seg in item
                        <span class="md-${seg.kind}">${seg.text}</span>
                        @end
                    </span></li>
                @end
            </ul>
        @end
    @end
</div>

