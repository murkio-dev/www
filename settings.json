{
    "app": {
        "name": "Murkio",
        "version": "0.1.0",
        "license": "./LICENSE",
        "organization": {
            "name": "Murkio",
            "email": "team@murkio.com"
        }
    },
    "dev": {
        "entry": "./src/main.pierrot",
        "open": false,
        "host": "localhost",
        "port": "3000",
        "strictPort": true,
        "dotenv": "./.env",
        "proxy": {
            "/v1/identity": "http://localhost:8080",
            "/payments/v1": "http://localhost:8084"
        }
    },
    "prd": {
        "build": "./build",
        "minify": true,
        "mangleNames": true,
        "selfHostFonts": true,
        "fontSubset": "auto",
        "csp": "meta",
        "domain": "https://murkio.com",
        "connectSrc": [
            "https://api.murkio.com"
        ]
    }
}
